{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    ".worktrees",
    "obsidian-plugin"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "types": [
      "bun"
    ],
    "paths": {
      "~/*": [
        "src/*"
      ]
    }
  }
}
