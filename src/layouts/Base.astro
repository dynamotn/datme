---
import { ClientRouter } from "astro:transitions"
import "~/styles/global.css"
import "~/styles/notebook.css"
import "~/styles/print.css"
import { site, type Lang } from "~/site.config"
import { t, langMeta, langPrefix } from "~/lib/i18n"
import { slugToUrl } from "~/lib/slug"
import Icon from "~/components/Icon.astro"
import Explorer from "~/components/Explorer.astro"
import { navLinks } from "~/lib/nav"
import { ogPath } from "~/lib/og-url"
import { customCssFile, fontsHref, themeCss } from "~/lib/theme"
import Analytics from "~/components/Analytics.astro"
import Filters from "~/components/Filters.astro"
import DevProblems from "~/components/DevProblems.astro"
import { serializeLd, type JsonLd } from "~/lib/jsonld"

interface Props {
  lang: Lang
  title: string
  description?: string
  image?: string
  /** URL of this page in every language, for the language switch and hreflang. */
  alternates: Partial<Record<Lang, string>>
  /** Languages the page really exists in; hreflang only lists these. Defaults to every alternate. */
  translatedIn?: Lang[]
  /** Canonical URL when it is another page, e.g. the original of an untranslated note. */
  canonicalUrl?: string
  /** Whether the right rail slot is used. */
  rail?: boolean
  /** Visual style of the page; defaults to the configured one. */
  look?: "notebook" | "classic"
  /** schema.org structured data describing the page. */
  jsonLd?: JsonLd[]
  /** URL of the RSS feed of this page's notes, next to the site's. */
  feed?: string
}
const {
  lang,
  title,
  description,
  image,
  alternates,
  translatedIn,
  canonicalUrl,
  rail = false,
  look = site.appearance.style,
  jsonLd = [],
  feed,
} = Astro.props
const nav = navLinks(lang)
// Pages without their own image share the generated card of the home page.
const ogUrl = image ?? ogPath(langPrefix(lang) + "index")
const s = t(lang)
const siteTitle = site.title[lang]
const fullTitle = title === siteTitle ? title : `${title} · ${siteTitle}`
const home = slugToUrl(langPrefix(lang) + "index")
const abs = (p: string) => (site.url ? new URL(p, site.url + "/").href : p)
const canonical = abs(canonicalUrl ?? Astro.url.pathname)
const rss = slugToUrl(langPrefix(lang) + "index.xml")
const year = new Date().getFullYear()
---

<!doctype html>
<html lang={langMeta(lang).html} data-lang={lang} data-look={look} data-offline={site.offline ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {fontsHref() && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {fontsHref() && <link rel="stylesheet" href={fontsHref()} />}
    {themeCss() && <style is:inline set:html={themeCss()} />}
    {
      site.offline && (
        <>
          <link rel="manifest" href="/manifest.webmanifest" />
          <link rel="apple-touch-icon" href="/icon-192.png" />
        </>
      )
    }
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href={rss} />
    {feed && <link rel="alternate" type="application/rss+xml" title={fullTitle} href={feed} />}
    {
      site.langs.map(
        (l) =>
          alternates[l] &&
          (!translatedIn || translatedIn.includes(l)) && (
            <link rel="alternate" hreflang={langMeta(l).html} href={abs(alternates[l]!)} />
          ),
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    {ogUrl && <meta property="og:image" content={abs(ogUrl)} />}
    {ogUrl && !image && <meta property="og:image:width" content="1200" />}
    {ogUrl && !image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogUrl ? "summary_large_image" : "summary"} />
    {site.me.map((href) => <link rel="me" href={href} />)}
    {site.fediverse && <meta name="fediverse:creator" content={site.fediverse} />}
    {
      site.webmentions && (
        <>
          <link rel="webmention" href={`https://webmention.io/${site.webmentions.domain}/webmention`} />
          <link rel="pingback" href={`https://webmention.io/${site.webmentions.domain}/xmlrpc`} />
        </>
      )
    }
    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={serializeLd(data)} />)}
    <meta name="theme-color" content="#f6f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111210" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      ;(() => {
        const apply = (doc) => {
          let theme = null
          let reader = null
          let hidden = ""
          try {
            theme = localStorage.getItem("theme")
            reader = localStorage.getItem("reader")
            hidden = localStorage.getItem("sidebars") || ""
            doc.documentElement.classList.toggle("stack-mode", localStorage.getItem("stack") === "1")
          } catch {}
          theme ??= matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"
          doc.documentElement.dataset.theme = theme
          doc.documentElement.classList.toggle("reader", reader === "1")
          doc.documentElement.classList.toggle("hide-left", hidden.includes("left"))
          doc.documentElement.classList.toggle("hide-right", hidden.includes("right"))
        }
        apply(document)
        document.addEventListener("astro:before-swap", (e) => apply(e.newDocument))
      })()
    </script>
    <ClientRouter fallback="swap" />
    <Analytics />
  </head>
  <body data-copy={s.copy} data-copied={s.copied} data-close={s.close} data-prev={s.previous} data-next={s.next} data-share-passage={s.sharePassage}>
    {/* In <body> so it comes after Astro's own stylesheets, which go at the end of <head>. */}
    {customCssFile() && <link rel="stylesheet" href="/custom.css" />}
    <header class="site-header">
      <button class="icon-btn menu-btn" type="button" data-nav-toggle aria-label={s.menu}>
        <Icon name="menu" />
      </button>
      <a class="brand" href={home}>
        <span class="brand-mark">{site.logo}</span>
        <span class="brand-name">{siteTitle}</span>
      </a>
      <nav class="main-nav" aria-label={s.menu}>
        {nav.map((l) => <a href={l.url}>{l.label}</a>)}
      </nav>
      <div class="header-spacer"></div>
      <button class="search-trigger" type="button" data-open-search aria-label={s.search}>
        <Icon name="search" />
        <span>{s.searchPlaceholder}</span>
        <kbd>Ctrl K</kbd>
      </button>
      <div class="header-spacer hide-sm"></div>
      <button class="icon-btn" type="button" data-open-graph aria-label={s.globalGraph} title={`${s.globalGraph} (Ctrl G)`}>
        <Icon name="graph" />
      </button>
      <button class="icon-btn sidebar-toggle" type="button" data-sidebar-toggle="left" aria-label={s.toggleLeft} title={s.toggleLeft} aria-pressed="false">
        <Icon name="panelLeft" />
      </button>
      {
        rail && (
          <button class="icon-btn sidebar-toggle" type="button" data-sidebar-toggle="right" aria-label={s.toggleRight} title={s.toggleRight} aria-pressed="false">
            <Icon name="panelRight" />
          </button>
        )
      }
      {
        site.stackedPages && rail && (
          <button class="icon-btn stack-toggle" type="button" data-stack-toggle aria-label={s.stackMode} title={s.stackMode} aria-pressed="false">
            <Icon name="layers" />
          </button>
        )
      }
      <button class="icon-btn" type="button" data-reader-toggle aria-label={s.readerMode} title={s.readerMode} aria-pressed="false">
        <Icon name="book" />
      </button>
      <button class="icon-btn" type="button" data-theme-toggle aria-label={s.theme} title={s.theme}>
        <Icon name="sun" class="theme-sun" />
        <Icon name="moon" class="theme-moon" />
      </button>
      {
        site.langs.length > 1 && (
          <nav class="lang-switch" aria-label={s.language}>
            {
              site.langs.map((l) => (
                <a
                  href={alternates[l] ?? slugToUrl(langPrefix(l) + "index")}
                  hreflang={langMeta(l).html}
                  aria-current={l === lang ? "true" : undefined}
                  title={langMeta(l).name}
                >
                  {langMeta(l).short}
                </a>
              ))
            }
          </nav>
        )
      }
    </header>

    <div class:list={["shell", { "no-right": !rail }]}>
      <aside class="sidebar sidebar-left" transition:persist={`explorer-${lang}`} data-sidebar>
        <Explorer lang={lang} />
      </aside>
      <main class="main" data-pagefind-body>
        <slot />
        <footer class="site-footer">
          <span>© {year} {site.author} · <a href={rss}>{s.rss}</a> <DevProblems /></span>
          <nav>
            {
              Object.entries(site.footerLinks).map(([label, href]) => (
                <a href={href} target={href.startsWith("http") ? "_blank" : undefined} rel="noopener">
                  {label}
                </a>
              ))
            }
          </nav>
        </footer>
      </main>
      {
        rail && (
          <aside class="sidebar sidebar-right">
            <slot name="rail" />
          </aside>
        )
      }
    </div>

    <dialog class="modal" data-search-dialog data-lang={lang} transition:persist={`search-${lang}`}>
      <div class="search-input-row">
        <Icon name="search" />
        <input type="search" placeholder={s.searchPlaceholder} aria-label={s.search} autocomplete="off" spellcheck="false" />
        <kbd>Esc</kbd>
      </div>
      <Filters lang={lang} kinds={["folder", "type"]} scope="search" />
      <ul class="search-results" role="listbox" data-empty={s.searchEmpty}></ul>
      <div class="modal-foot">
        <span><kbd>↑</kbd> <kbd>↓</kbd> {s.navigate}</span>
        <span><kbd>↵</kbd> {s.open}</span>
        <span><kbd>Esc</kbd> {s.close}</span>
      </div>
    </dialog>

    <dialog class="modal graph-modal" data-graph-dialog>
      <div class="modal-head">
        <span>{s.globalGraph}</span>
        <Filters lang={lang} kinds={["folder", "tag"]} scope="graph" />
        <button class="icon-btn" type="button" data-close-dialog aria-label={s.close}>
          <Icon name="close" />
        </button>
      </div>
      <div class="graph-full">
        <canvas data-graph="global" data-lang={lang}></canvas>
      </div>
    </dialog>

    <script>
      import "~/scripts/app"
    </script>
  </body>
</html>
