---
import { ClientRouter } from "astro:transitions"
// Linked by hand rather than bundled, so a page loads only its own look's sheet, KaTeX's only with math, and print's off the critical path.
import globalCss from "~/styles/global.css?url"
import notebookCss from "~/styles/notebook.css?url"
import gardenCss from "~/styles/garden.css?url"
import resumeCss from "~/styles/resume.css?url"
import darkroomCss from "~/styles/darkroom.css?url"
import printCss from "~/styles/print.css?url"
import katexCss from "katex/dist/katex.min.css?url"
import { site, type Lang, type Style } from "~/site.config"
import { THEME_COLOR } from "~/lib/pwa"
import { startsDark, type Frame } from "~/lib/look"
import { t, langMeta, langPrefix, langDir } from "~/lib/i18n"
import { slugToUrl } from "~/lib/slug"
import { absUrl, withBase } from "~/lib/base"
import Icon from "~/components/Icon.astro"
import Explorer from "~/components/Explorer.astro"
import { navLinks } from "~/lib/nav"
import { ogPath } from "~/lib/og-url"
import { MONO_FONT_CSS, MONO_FONT_ORIGIN } from "~/lib/fonts"
import { customCssFile, fontsHref, themeCss } from "~/lib/theme"
import Analytics from "~/components/Analytics.astro"
import Filters from "~/components/Filters.astro"
import DevProblems from "~/components/DevProblems.astro"
import { serializeLd, type JsonLd } from "~/lib/jsonld"
import datmeLogo from "~/assets/datme.svg?raw"
import { userHead } from "~/lib/markdown"
import { hasDecks } from "~/lib/decks"

interface Props {
  lang: Lang
  title: string
  description?: string
  image?: string
  /** URL of this page in every language, for the language switch and hreflang. */
  alternates: Partial<Record<Lang, string>>
  /** Languages the page really exists in; hreflang only lists these. Defaults to every alternate. */
  translatedIn?: Lang[]
  /** Canonical URL when it is another page, e.g. the original of an untranslated note. */
  canonicalUrl?: string
  /** Whether the right rail slot is used. */
  rail?: boolean
  /** Visual style of the page; defaults to the configured one. */
  look?: Style
  /** Navigation around the page: all of it, all but the rail, or a thin bar of its own. */
  frame?: Frame
  /** schema.org structured data describing the page. */
  jsonLd?: JsonLd[]
  /** URL of the RSS feed of this page's notes, next to the site's. */
  feed?: string
  /** URL of the page as plain markdown. */
  mdAlternate?: string
  /** URL of the page's oEmbed JSON, for sites that embed it. */
  oembed?: string
  /** Keep the page out of search engines, e.g. a draft built for preview. */
  noindex?: boolean
}
const {
  lang,
  title,
  description,
  image,
  alternates,
  translatedIn,
  canonicalUrl,
  rail = false,
  look = site.appearance.style,
  frame = "full",
  jsonLd = [],
  feed,
  mdAlternate,
  oembed,
  noindex = false,
} = Astro.props
const nav = navLinks(lang)
// Pages without their own image share the generated card of the home page.
const ogUrl = image ?? ogPath(langPrefix(lang) + "index")
const s = t(lang)
const siteTitle = site.title[lang]
const fullTitle = title === siteTitle ? title : `${title} · ${siteTitle}`
const home = slugToUrl(langPrefix(lang) + "index")
const canonical = absUrl(canonicalUrl ?? Astro.url.pathname)
const rss = slugToUrl(langPrefix(lang) + "index.xml")
const year = new Date().getFullYear()
// The sprout is decoration next to its name; the link says "datme".
const datmeMark = datmeLogo
  .replace(/<title>[\s\S]*?<\/title>|<!--[\s\S]*?-->/g, "")
  .replace(/>\s+</g, "><")
  .trim().replace(/role="img" aria-label="datme"/, 'class="datme-mark" aria-hidden="true" focusable="false"')
const credit = s.poweredBy.split("{datme}")
// Tags the vault's datme.config.mjs adds to every page.
const pluginHead = await userHead()
// A page that stands alone keeps only a bar with the site's name and the scheme toggle.
const minimal = frame === "minimal"
const withRail = rail && frame === "full"
// The page is rendered first so its <head> knows whether it holds math.
const main = await Astro.slots.render("default")
const railHtml = withRail && Astro.slots.has("rail") ? await Astro.slots.render("rail") : ""
const hasMath = /class="katex[\s"]/.test(main) || /class="katex[\s"]/.test(railHtml)
const LOOK_CSS: Partial<Record<Style, string>> = { notebook: notebookCss, garden: gardenCss, resume: resumeCss, darkroom: darkroomCss }
const lookCss = LOOK_CSS[look]
---

<!doctype html>
<html lang={langMeta(lang).html} dir={langDir(lang)} data-lang={lang} data-look={look} data-offline={site.offline ? "" : undefined} data-mermaid={`${site.theme.mermaid.light} ${site.theme.mermaid.dark}`} data-theme={site.theme.scheme === "auto" ? undefined : site.theme.scheme} data-scheme-default={startsDark(look) ? "dark" : undefined} data-chrome={frame}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href={MONO_FONT_ORIGIN} crossorigin />
    {/* The monospace face loads without holding up the first paint; code shows in a fallback until it arrives. */}
    <link rel="preload" as="style" href={MONO_FONT_CSS} />
    <link rel="stylesheet" href={MONO_FONT_CSS} media="print" data-async-style />
    <noscript><link rel="stylesheet" href={MONO_FONT_CSS} /></noscript>
    {/* An inline script rather than an onload attribute: the CSP allows inline scripts by hash, never handlers. */}
    <script is:inline>
      document.querySelectorAll("link[data-async-style]").forEach((l) => {
        const on = () => (l.media = "all")
        if (l.sheet) on()
        else l.addEventListener("load", on, { once: true })
      })
    </script>
    {fontsHref() && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {fontsHref() && <link rel="stylesheet" href={fontsHref()} />}
    {themeCss() && <style is:inline set:html={themeCss()} />}
    {
      site.offline && (
        <>
          <link rel="manifest" href={withBase("/manifest.webmanifest")} />
          <link rel="apple-touch-icon" href={withBase("/icon-192.png")} />
        </>
      )
    }
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href={rss} />
    {feed && <link rel="alternate" type="application/rss+xml" title={fullTitle} href={feed} />}
    {mdAlternate && <link rel="alternate" type="text/markdown" href={mdAlternate} />}
    {oembed && <link rel="alternate" type="application/json+oembed" href={absUrl(oembed)} title={title} />}
    {
      site.langs.map(
        (l) =>
          alternates[l] &&
          (!translatedIn || translatedIn.includes(l)) && (
            <link rel="alternate" hreflang={langMeta(l).html} href={absUrl(alternates[l]!)} />
          ),
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    {ogUrl && <meta property="og:image" content={absUrl(ogUrl)} />}
    {ogUrl && !image && <meta property="og:image:width" content="1200" />}
    {ogUrl && !image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogUrl ? "summary_large_image" : "summary"} />
    {site.me.map((href) => <link rel="me" href={href} />)}
    {site.fediverse && <meta name="fediverse:creator" content={site.fediverse} />}
    {
      site.webmentions && (
        <>
          <link rel="webmention" href={`https://webmention.io/${site.webmentions.domain}/webmention`} />
          <link rel="pingback" href={`https://webmention.io/${site.webmentions.domain}/xmlrpc`} />
        </>
      )
    }
    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={serializeLd(data)} />)}
    {
      site.theme.scheme === "auto" ? (
        <>
          <meta name="theme-color" content={THEME_COLOR[look].light} media="(prefers-color-scheme: light)" />
          <meta name="theme-color" content={THEME_COLOR[look].dark} media="(prefers-color-scheme: dark)" />
        </>
      ) : (
        <meta name="theme-color" content={THEME_COLOR[look][site.theme.scheme]} />
      )
    }
    <script is:inline>
      ;(() => {
        const apply = (doc) => {
          let theme = null
          let reader = null
          let hidden = ""
          try {
            theme = localStorage.getItem("theme")
            reader = localStorage.getItem("reader")
            hidden = localStorage.getItem("sidebars") || ""
            doc.documentElement.classList.toggle("stack-mode", localStorage.getItem("stack") === "1")
          } catch {}
          // Same order as initialTheme (src/lib/theme-init.ts): the stored choice, the page's own
          // default, the scheme set in datme.yaml (both on <html>), then the system's.
          const { schemeDefault, theme: siteScheme } = doc.documentElement.dataset
          theme = [theme, schemeDefault, siteScheme].find((v) => v === "light" || v === "dark")
          theme ??= matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"
          doc.documentElement.dataset.theme = theme
          doc.documentElement.classList.toggle("reader", reader === "1")
          doc.documentElement.classList.toggle("hide-left", hidden.includes("left"))
          doc.documentElement.classList.toggle("hide-right", hidden.includes("right"))
          // Reading preferences; the "Aa" menu writes them (src/scripts/prefs.ts).
          let prefs = {}
          try {
            prefs = JSON.parse(localStorage.getItem("prefs") || "{}")
          } catch {}
          doc.documentElement.style.setProperty("--reading-scale", String(Number(prefs.size) || 1))
          doc.documentElement.classList.toggle("font-legible", prefs.legible === true)
          doc.documentElement.classList.toggle("high-contrast", prefs.contrast === true)
        }
        apply(document)
        document.addEventListener("astro:before-swap", (e) => apply(e.newDocument))
      })()
    </script>
    <ClientRouter fallback="swap" />
    <Analytics />
    {pluginHead && <Fragment set:html={pluginHead} />}
    {/* In cascade order, which src/scripts/styles.ts restores after a navigation adds one. */}
    {hasMath && <link rel="stylesheet" href={katexCss} data-css="1" />}
    <link rel="stylesheet" href={globalCss} data-css="2" />
    {lookCss && <link rel="stylesheet" href={lookCss} data-css="3" />}
    <link rel="stylesheet" href={printCss} media="print" data-css="4" />
  </head>
  <body data-copy={s.copy} data-copied={s.copied} data-close={s.close} data-prev={s.previous} data-next={s.next} data-share-passage={s.sharePassage} data-highlight={s.highlight} data-highlights={s.highlights} data-highlight-note={s.highlightNote} data-highlight-save={s.highlightSave} data-highlight-remove={s.highlightRemove} data-highlight-lost={s.highlightLost} data-highlights-empty={s.highlightsEmpty} data-highlights-export={s.highlightsExport}>
    {/* In <body> so it comes after Astro's own stylesheets, which go at the end of <head>. */}
    {customCssFile() && <link rel="stylesheet" href={withBase("/custom.css")} />}
    <header class:list={["site-header", { "site-bar": minimal }]}>
      {
        !minimal && (
          <button class="icon-btn menu-btn" type="button" data-nav-toggle aria-label={s.menu}>
            <Icon name="menu" />
          </button>
        )
      }
      <a class="brand" href={home}>
        <span class="brand-mark">{site.logo}</span>
        <span class="brand-name">{siteTitle}</span>
      </a>
      {minimal && <div class="header-spacer"></div>}
      {
        !minimal && (
          <>
            <nav class="main-nav" aria-label={s.siteSections}>
              {nav.map((l) => <a href={l.url}>{l.label}</a>)}
            </nav>
            <div class="header-spacer"></div>
            <button class="search-trigger" type="button" data-open-search aria-label={s.search}>
              <Icon name="search" />
              <span>{s.searchPlaceholder}</span>
              <kbd>Ctrl K</kbd>
            </button>
            <div class="header-spacer hide-sm"></div>
            {
              hasDecks(lang) && (
                <a class="icon-btn due-badge" href={slugToUrl(langPrefix(lang) + "practice")} data-due-badge data-label={s.practiceDue} hidden>
                  🧠<span></span>
                </a>
              )
            }
            <button class="icon-btn header-random" type="button" data-random aria-label={s.randomNote} title={`${s.randomNote} (R)`}>
              <span aria-hidden="true">🎲</span>
            </button>
            <button class="icon-btn" type="button" data-open-graph aria-label={s.globalGraph} title={`${s.globalGraph} (Ctrl G)`}>
              <Icon name="graph" />
            </button>
            {/* One menu for how the page is laid out and read; the buttons keep the data attributes src/scripts/app.ts binds to. */}
            <div class="prefs">
              <button class="icon-btn prefs-toggle" type="button" data-prefs-toggle aria-label={s.view} title={s.view} aria-expanded="false">
                <Icon name="sliders" />
              </button>
              <div class="prefs-panel" data-prefs-panel role="group" aria-label={s.view} hidden>
                <div class="prefs-group" role="group" aria-label={s.layout}>
                  <span class="prefs-label">{s.layout}</span>
                  <button class="prefs-item sidebar-toggle" type="button" data-sidebar-toggle="left" aria-pressed="false">
                    <Icon name="panelLeft" /> {s.toggleLeft}
                  </button>
                  {
                    withRail && (
                      <button class="prefs-item sidebar-toggle" type="button" data-sidebar-toggle="right" aria-pressed="false">
                        <Icon name="panelRight" /> {s.toggleRight}
                      </button>
                    )
                  }
                  {
                    site.stackedPages && withRail && (
                      <button class="prefs-item stack-toggle" type="button" data-stack-toggle aria-pressed="false">
                        <Icon name="layers" /> {s.stackMode}
                      </button>
                    )
                  }
                  <button class="prefs-item" type="button" data-reader-toggle aria-pressed="false">
                    <Icon name="book" /> {s.readerMode}
                  </button>
                </div>
                <div class="prefs-group" role="group" aria-label={s.prefs}>
                  <span class="prefs-label">{s.prefs}</span>
                  <div class="prefs-size">
                    <span>{s.prefsSize}</span>
                    <button type="button" data-pref-size="-1" aria-label={`${s.prefsSize} −`}>A−</button>
                    <output data-pref-size-out>100%</output>
                    <button type="button" data-pref-size="1" aria-label={`${s.prefsSize} +`}>A+</button>
                  </div>
                  <label><input type="checkbox" data-pref="legible" /> {s.prefsLegible}</label>
                  <label><input type="checkbox" data-pref="contrast" /> {s.prefsContrast}</label>
                </div>
                <button type="button" class="prefs-forget" data-open-highlights>🖍 {s.highlights}</button>
                <button type="button" class="prefs-forget" data-forget-footprints data-done={s.forgotten}>{s.forgetFootprints}</button>
              </div>
            </div>
          </>
        )
      }
      <button class="icon-btn" type="button" data-theme-toggle aria-label={s.theme} title={s.theme}>
        <Icon name="sun" class="theme-sun" />
        <Icon name="moon" class="theme-moon" />
      </button>
      {
        !minimal && site.langs.length > 1 && (
          <details class="lang-switch" data-menu>
            <summary aria-label={s.language} title={`${s.language}: ${langMeta(lang).name}`}>
              <span>{langMeta(lang).short}</span>
              <Icon name="chevron" class="lang-caret" />
            </summary>
            <ul>
              {
                site.langs.map((l) => (
                  <li>
                    <a href={alternates[l] ?? slugToUrl(langPrefix(l) + "index")} hreflang={langMeta(l).html} aria-current={l === lang ? "true" : undefined} lang={langMeta(l).html}>
                      {langMeta(l).name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        )
      }
    </header>

    <div class:list={["shell", { "no-right": !withRail }]}>
      {
        !minimal && (
          <aside class="sidebar sidebar-left" transition:persist={`explorer-${lang}`} data-sidebar aria-label={s.explorer}>
            <Explorer lang={lang} />
            {/* The header has no room for it on the narrowest phones; global.css shows it there instead. */}
            <button class="drawer-random" type="button" data-random>
              <span aria-hidden="true">🎲</span> {s.randomNote}
            </button>
          </aside>
        )
      }
      <main class="main">
        <Fragment set:html={main} />
      </main>
      {
        withRail && (
          <aside class="sidebar sidebar-right" aria-label={s.pageRail}>
            <Fragment set:html={railHtml} />
          </aside>
        )
      }
      {/* After the rail, which a narrow screen stacks under the note: the footer stays last. */}
      <footer class="site-footer">
        <span>© {year} {site.author} · <a href={rss}>{s.rss}</a> <DevProblems /></span>
        {
          !minimal && (
            <>
              <nav>
                {
                  Object.entries(site.footerLinks).map(([label, href]) => (
                    <a href={withBase(href)} target={href.startsWith("http") ? "_blank" : undefined} rel="noopener">
                      {label}
                    </a>
                  ))
                }
              </nav>
              {
                site.poweredBy && (
                  <p class="datme-credit">
                    <Fragment set:html={datmeMark} />
                    {credit[0]}
                    <a href="https://gitlab.com/dynamo-brain/datme" rel="noopener">datme</a>
                    {credit[1]}
                  </p>
                )
              }
            </>
          )
        }
      </footer>
    </div>

    {
      !minimal && (
        <>
          <dialog
            class="modal"
            data-search-dialog
            data-lang={lang}
            data-engine={site.search.engine}
            data-similar={site.related.semantic ? s.similarNotes : undefined}
            data-threshold={site.related.semantic ? site.related.semantic.threshold : undefined}
            data-model={site.search.meaning && site.related.semantic ? site.related.semantic.model : undefined}
            transition:persist={`search-${lang}`}
          >
            <div class="search-input-row">
              <Icon name="search" />
              <input
                type="search"
                placeholder={s.searchPlaceholder}
                aria-label={s.search}
                role="combobox"
                aria-autocomplete="list"
                aria-controls="search-results"
                aria-expanded="false"
                autocomplete="off"
                spellcheck="false"
              />
              {
                site.search.meaning && site.related.semantic && site.search.engine === "minisearch" && (
                  <button class="search-meaning" type="button" aria-pressed="false" data-search-meaning title={s.searchMeaningHint} data-loading={s.searchMeaningLoading}>
                    ✨ <span>{s.searchMeaning}</span>
                  </button>
                )
              }
              <kbd>Esc</kbd>
              <button class="icon-btn search-close" type="button" data-close-dialog aria-label={s.close}>
                <Icon name="close" />
              </button>
            </div>
            <Filters lang={lang} kinds={["folder", "type", "stage", "fresh"]} scope="search" />
            <ul id="search-results" class="search-results" role="listbox" data-empty={s.searchEmpty}></ul>
            <div class="modal-foot">
              <span><kbd>↑</kbd> <kbd>↓</kbd> {s.navigate}</span>
              <span><kbd>↵</kbd> {s.open}</span>
              <span><kbd>Esc</kbd> {s.close}</span>
            </div>
          </dialog>

          <dialog class="modal graph-modal" data-graph-dialog data-view={site.graph.view}>
            <div class="modal-head">
              <span>{s.globalGraph}</span>
              <Filters lang={lang} kinds={["folder", "tag", "stage"]} scope="graph" />
              <select
                data-graph-color
                aria-label={s.graphColorBy}
                data-fresh-labels={JSON.stringify({ month: s.freshMonth, year: s.freshYear, older: s.freshOlder })}
                data-visited-label={s.visitedLabel}
              >
                <option value="">{s.graphColorBy}: {s.graphColorNone}</option>
                <option value="folder">{s.graphColorBy}: {s.folder}</option>
                <option value="type">{s.graphColorBy}: {s.graphColorType}</option>
                {Object.keys(site.stages).length > 0 && <option value="stage">{s.graphColorBy}: {s.graphColorStage}</option>}
                {site.related.semantic && site.topics !== false && <option value="topic">{s.graphColorBy}: {s.graphColorTopic}</option>}
                <option value="fresh">{s.graphColorBy}: {s.graphColorFresh}</option>
                <option value="visited">{s.graphColorBy}: {s.graphColorVisited}</option>
              </select>
              <button class="graph-space" type="button" data-graph-3d aria-pressed="false" title={s.graph3d}>3D</button>
              <button class="icon-btn" type="button" data-close-dialog aria-label={s.close}>
                <Icon name="close" />
              </button>
            </div>
            <div class="graph-full">
              <canvas data-graph="global" data-lang={lang}></canvas>
              <div class="graph-zoom" role="group" aria-label={s.zoom}>
                <button type="button" data-graph-zoom="1" aria-label={s.zoomIn} title={s.zoomIn}>+</button>
                <button type="button" data-graph-zoom="-1" aria-label={s.zoomOut} title={s.zoomOut}>−</button>
              </div>
            </div>
            <div class="graph-foot">
              <label class="graph-time">
                <span>{s.graphTime}</span>
                <input type="range" data-graph-time step="1" />
                <output data-graph-time-label></output>
              </label>
              <div class="graph-legend" data-graph-legend></div>
            </div>
          </dialog>
        </>
      )
    }

    <script>
      import "~/scripts/app"
      import "~/scripts/styles"
    </script>
  </body>
</html>
