---
import type { Note } from "~/lib/vault"
import { t } from "~/lib/i18n"
import type { Item } from "~/lib/note-layouts"

interface Props {
  note: Note
  item: Item
}
const { note, item } = Astro.props
const s = t(note.lang)
const rating = item.rating && Math.round(item.rating)
---

<div class:list={["item-head", { "is-upright": item.upright }]}>
  {note.cover && <img class="item-cover" src={note.cover} alt="" />}
  <div class="item-id">
    <slot />
    {item.byline.length > 0 && <p class="item-byline">{item.byline.join(" · ")}</p>}
    {
      (item.status || rating) && (
        <p class="item-facts">
          {item.status && <span class="chip item-status">{item.status}</span>}
          {rating && (
            <span class="book-rating" title={`${s.ratingOf} ${item.rating}/5`} aria-label={`${s.ratingOf} ${item.rating}/5`}>
              {"★".repeat(rating)}
              <span class="book-rating-rest">{"★".repeat(5 - rating)}</span>
            </span>
          )}
        </p>
      )
    }
    {
      item.links.length > 0 && (
        <p class="project-links item-links">
          {item.links.map((l) => (
            <a href={l.href} rel="noopener">
              {l.label} ↗
            </a>
          ))}
        </p>
      )
    }
  </div>
</div>
