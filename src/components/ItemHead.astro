---
import type { Note } from "~/lib/vault"
import { t } from "~/lib/i18n"
import type { Item } from "~/lib/note-layouts"
import { site } from "~/site.config"

interface Props {
  note: Note
  item: Item
}
const { note, item } = Astro.props
const s = t(note.lang)
const rating = item.rating && Math.round(item.rating)
const scale = site.conventions.ratingScale
---

<div class:list={["item-head", { "is-upright": item.upright, "is-round": item.round }]}>
  {note.cover && <img class="item-cover" src={note.cover} alt="" fetchpriority="high" decoding="async" />}
  <div class="item-id">
    <slot />
    {item.byline.length > 0 && <p class="item-byline">{item.byline.join(" · ")}</p>}
    {
      (item.status || rating) && (
        <p class="item-facts">
          {item.status && <span class="chip item-status">{item.status}</span>}
          {rating && (
            <span class="book-rating" title={`${s.ratingOf} ${item.rating}/${scale}`} aria-label={`${s.ratingOf} ${item.rating}/${scale}`}>
              {"★".repeat(rating)}
              <span class="book-rating-rest">{"★".repeat(scale - rating)}</span>
            </span>
          )}
        </p>
      )
    }
    {item.audio && <audio class="item-audio" src={item.audio} controls preload="none" aria-label={note.title} />}
    {
      item.links.length > 0 && (
        <p class="project-links item-links">
          {item.links.map((l) => (
            <a href={l.href} rel="noopener">
              {l.label} ↗
            </a>
          ))}
        </p>
      )
    }
  </div>
</div>
