---
import type { FolderNode } from "~/lib/vault"
import { countNotes } from "~/lib/vault"
import { site } from "~/site.config"
import Icon from "./Icon.astro"
import { folderIcon, noteIcon } from "~/lib/icons"

interface Props {
  folder: FolderNode
}
const { folder } = Astro.props
---

<ul>
  {
    folder.folders.map((f) => (
      <li class="folder">
        {/* The link sits beside the toggle, not inside it: a summary must hold no other control. */}
        <details data-dir={f.dir}>
          <summary aria-label={f.name}>
            <span class="chev">
              <Icon name="chevron" />
            </span>
          </summary>
          <Astro.self folder={f} />
        </details>
        <a class="folder-link" href={f.url}>
          <Fragment set:html={folderIcon(f.dir)} />
          {f.name}
        </a>
        <span class="count">{countNotes(f)}</span>
      </li>
    ))
  }
  {
    folder.notes.map((n) => (
      <li>
        <a href={n.url} title={n.title}>
          {n.stage && folder.dir === "" ? <span class="stage-icon">{site.stages[n.stage].icon}</span> : null}
          <Fragment set:html={noteIcon(n.key, n.source.fm)} />
          {n.title}
        </a>
      </li>
    ))
  }
</ul>
