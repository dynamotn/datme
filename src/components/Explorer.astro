---
import type { Lang } from "~/site.config"
import { getVault } from "~/lib/vault"
import { t } from "~/lib/i18n"
import { navLinks } from "~/lib/nav"
import ExplorerNode from "./ExplorerNode.astro"

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const tree = getVault().trees[lang]
const s = t(lang)
const nav = navLinks(lang)
---

<nav class="side-nav" aria-label={s.menu}>
  {nav.map((l) => <a href={l.url} data-nav>{l.label}</a>)}
</nav>
<p class="panel-title">{s.explorer}</p>
<div class="explorer" data-explorer={lang}>
  <ExplorerNode folder={tree} />
</div>
