---
import type { Note } from "~/lib/vault"
import { site } from "~/site.config"
import { t, formatDate, langPrefix } from "~/lib/i18n"
import { slugToUrl } from "~/lib/slug"
import Icon from "./Icon.astro"
import PropValue from "./PropValue.astro"
import { noteProperties } from "~/lib/properties"

interface Props {
  note: Note
  words: number
}
const { note, words } = Astro.props
const s = t(note.lang)
const tagUrl = (tag: string) => slugToUrl(langPrefix(note.lang) + "tags/" + tag)
const minutes = Math.max(1, Math.round(words / 220))
const stageFolder = note.dir.split("/")[0]
const props = noteProperties(note)
---

<div class="chips">
  {
    note.stage && (
      <a class="chip stage" href={slugToUrl(langPrefix(note.lang) + stageFolder) + "/"}>
        {site.stages[note.stage].icon} {site.stages[note.stage].label[note.lang]}
      </a>
    )
  }
  {
    note.types.map((ty) => (
      <a class="chip type" href={tagUrl(site.conventions.typePrefix + ty)}>
        {ty}
      </a>
    ))
  }
</div>
<slot />
<div class="note-meta">
  {
    note.created && (
      <span title={s.created}>
        <Icon name="calendar" />
        <time datetime={note.created.toISOString()}>{formatDate(note.created, note.lang)}</time>
      </span>
    )
  }
  {
    note.updated && formatDate(note.updated, note.lang) !== formatDate(note.created, note.lang) && (
      <span title={s.updated}>
        <Icon name="edit" />
        <time datetime={note.updated.toISOString()}>{formatDate(note.updated, note.lang)}</time>
      </span>
    )
  }
  {
    words > 0 && (
      <span>
        <Icon name="clock" />
        {s.readingTime(minutes)} · {s.words(words)}
      </span>
    )
  }
</div>
{
  note.tags.filter((x) => !x.startsWith(site.conventions.typePrefix)).length > 0 && (
    <div class="chips">
      {note.tags
        .filter((x) => !x.startsWith(site.conventions.typePrefix))
        .map((tag) => (
          <a class="chip tag" href={tagUrl(tag)}>
            {tag}
          </a>
        ))}
    </div>
  )
}
{
  props.length > 0 && (
    <details class="properties">
      <summary>{s.properties}</summary>
      <dl>
        {props.map(([key, value]) => (
          <>
            <dt>{key === "aliases" ? s.aliases : key}</dt>
            <dd>
              <PropValue value={value} />
            </dd>
          </>
        ))}
      </dl>
    </details>
  )
}
