---
import type { Note } from "~/lib/vault"
import { site, type Style } from "~/site.config"
import { t, formatDate, langPrefix } from "~/lib/i18n"
import { slugToUrl } from "~/lib/slug"
import Icon from "./Icon.astro"
import PropValue from "./PropValue.astro"
import { noteProperties } from "~/lib/properties"
import { typeInfo } from "~/lib/types"
import { isGarden } from "~/lib/look"

interface Props {
  note: Note
  words: number
  look: Style
}
const { note, words, look } = Astro.props
const garden = isGarden(look)
const s = t(note.lang)
const tagUrl = (tag: string) => slugToUrl(langPrefix(note.lang) + "tags/" + tag)
const minutes = Math.max(1, Math.round(words / 220))
const stageFolder = note.dir.split("/")[0]
const props = noteProperties(note)
const tended =
  note.updated && (!note.created || formatDate(note.updated, note.lang) !== formatDate(note.created, note.lang))
---

<div class="chips">
  {
    note.stage &&
      (note.stage === stageFolder ? (
        <a class:list={["chip stage", { "garden-stage": garden }]} href={slugToUrl(langPrefix(note.lang) + stageFolder) + "/"}>
          {site.stages[note.stage].icon} {site.stages[note.stage].label[note.lang]}
        </a>
      ) : (
        <span class:list={["chip stage", { "garden-stage": garden }]}>
          {site.stages[note.stage].icon} {site.stages[note.stage].label[note.lang]}
        </span>
      ))
  }
  {
    note.types.map((ty) => (
      <a class="chip type" href={tagUrl(site.conventions.typePrefix + ty)}>
        {typeInfo(ty, note.lang).icon} {typeInfo(ty, note.lang).label}
      </a>
    ))
  }
</div>
<slot />
<div class="note-meta">
  {
    garden ? (
      (note.created || tended) && (
        <p class="garden-dates">
          {note.created && (
            <>
              {s.planted} <time datetime={note.created.toISOString()}>{formatDate(note.created, note.lang)}</time>
            </>
          )}
          {note.created && tended && " · "}
          {tended && note.updated && (
            <>
              {s.lastTended}{" "}
              <time datetime={note.updated.toISOString()} data-tended title={formatDate(note.updated, note.lang)}>
                {formatDate(note.updated, note.lang)}
              </time>
            </>
          )}
        </p>
      )
    ) : (
      <>
  {
    note.created && (
      <span title={s.created}>
        <Icon name="calendar" />
        <time class="dt-published" datetime={note.created.toISOString()}>{formatDate(note.created, note.lang)}</time>
      </span>
    )
  }
  {
    note.updated && formatDate(note.updated, note.lang) !== formatDate(note.created, note.lang) && (
      <span title={s.updated}>
        <Icon name="edit" />
        <time class="dt-updated" datetime={note.updated.toISOString()}>{formatDate(note.updated, note.lang)}</time>
      </span>
    )
  }
      </>
    )
  }
  {
    words > 0 && (
      <span>
        <Icon name="clock" />
        {s.readingTime(minutes)} · {s.words(words)}
      </span>
    )
  }
</div>
{
  note.tags.filter((x) => !x.startsWith(site.conventions.typePrefix)).length > 0 && (
    <div class="chips">
      {note.tags
        .filter((x) => !x.startsWith(site.conventions.typePrefix))
        .map((tag) => (
          <a class="chip tag" href={tagUrl(tag)}>
            {tag}
          </a>
        ))}
    </div>
  )
}
{
  props.length > 0 && look !== "wiki" && (
    <details class="properties">
      <summary>{s.properties}</summary>
      <dl>
        {props.map(([key, value]) => (
          <>
            <dt>{key === "aliases" ? s.aliases : key}</dt>
            <dd>
              <PropValue value={value} />
            </dd>
          </>
        ))}
      </dl>
    </details>
  )
}
