---
import type { Note } from "~/lib/vault"
import { paperOf } from "~/lib/note-layouts"

interface Props {
  note: Note
}
const { note } = Astro.props
const paper = paperOf(note)
---

<div class="paper-head">
  {
    paper.authors.length > 0 && (
      <p class="paper-authors">
        {paper.authors.map((a, i) => (
          <>
            {i > 0 && ", "}
            {a.href ? (
              <a class="internal" href={a.href}>
                {a.text}
              </a>
            ) : (
              <span>{a.text}</span>
            )}
          </>
        ))}
      </p>
    )
  }
  {paper.affiliations.length > 0 && <p class="paper-affiliations">{paper.affiliations.join(" · ")}</p>}
  {paper.venue && <p class="paper-venue">{paper.venue}</p>}
  {
    paper.links.length > 0 && (
      <p class="project-links paper-links">
        {paper.links.map((l) => (
          <a href={l.href} rel="noopener">
            {l.label} ↗
          </a>
        ))}
      </p>
    )
  }
</div>
