---
import type { Note } from "~/lib/vault"
import { site } from "~/site.config"
import { renderNote } from "~/lib/markdown"
import { formatDate, t, langPrefix } from "~/lib/i18n"
import { slugToUrl } from "~/lib/slug"
import { stageOf, tileSize } from "~/lib/garden"

interface Props {
  note: Note
  /** A tile of the "recently tended" row (always small, dated) or of "paths in". */
  variant?: "recent" | "path"
}
const { note, variant } = Astro.props
const s = t(note.lang)
const stage = stageOf(note)
const size = variant === "recent" ? "small" : tileSize(note.stage)
const tags = note.tags.filter((x) => !x.startsWith(site.conventions.typePrefix))
const dated = (size !== "small" || variant === "recent") && note.updated
const description = size === "large" ? (await renderNote(note)).description : undefined
const tended = note.updated ? formatDate(note.updated, note.lang) : ""
---

<article
  class={variant ? `garden-tile is-${variant}` : "garden-tile"}
  data-size={size}
  data-stage={note.stage ?? ""}
  data-folder={note.dir.split("/")[0]}
  data-tags={tags.join(" ")}
>
  <h3 class="garden-tile-title">
    {
      stage ? (
        <span class="garden-tile-icon" role="img" aria-label={stage.label[note.lang]} title={stage.label[note.lang]}>
          {stage.icon}
        </span>
      ) : (
        <span class="garden-tile-icon" aria-hidden="true">
          📝
        </span>
      )
    }
    <a class="internal" href={note.url}>{note.title}</a>
  </h3>
  {description && <p class="garden-tile-desc">{description}</p>}
  {
    dated && (
      <p class="garden-tile-date">
        {s.tended}{" "}
        <time datetime={note.updated!.toISOString()} data-tended title={tended}>
          {tended}
        </time>
      </p>
    )
  }
  {
    size === "large" && tags.length > 0 && (
      <ul class="garden-tags">
        {tags.slice(0, 3).map((tag) => (
          <li>
            <a class="garden-tag" href={slugToUrl(langPrefix(note.lang) + "tags/" + tag)}>
              #{tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
