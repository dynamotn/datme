---
import type { Note } from "~/lib/vault"
import { getVault } from "~/lib/vault"
import { renderNote, renderSecret } from "~/lib/markdown"
import { encrypt } from "~/lib/encrypt"
import { site } from "~/site.config"
import { t, langMeta, formatDate } from "~/lib/i18n"
import { lookOf } from "~/lib/nav"
import { relatedNotes, unlinkedMentions } from "~/lib/related"
import { ogPath } from "~/lib/og-url"
import { noteLd } from "~/lib/jsonld"
import { hasMarkdown, mdUrl } from "~/lib/llms"
import { embeddable, oembedUrl } from "~/lib/oembed"
import Base from "~/layouts/Base.astro"
import Breadcrumbs from "../Breadcrumbs.astro"
import NoteMeta from "../NoteMeta.astro"
import Toc from "../Toc.astro"
import LocalGraph from "../LocalGraph.astro"
import Comments from "../Comments.astro"
import Subscribe from "../Subscribe.astro"
import Webmentions from "../Webmentions.astro"
import DevProblems from "../DevProblems.astro"
import SeriesBox from "../SeriesBox.astro"
import TrailBar from "../TrailBar.astro"
import DayNav from "../DayNav.astro"
import PageMenu from "../PageMenu.astro"
import Outdated from "../Outdated.astro"
import Collection from "../Collection.astro"
import CvHead from "../CvHead.astro"
import LinksHead from "../LinksHead.astro"
import { isCollection, itemOf, layoutHtml } from "~/lib/note-layouts"
import ItemHead from "../ItemHead.astro"
import { isOutdated } from "~/scripts/outdated"
import { hasHistory, historyUrl, noteVersions } from "~/lib/history"

interface Props {
  note: Note
}
const { note } = Astro.props
const vault = getVault()
const r = await renderNote(note)
const title = r.h1 ?? note.title
const backlinks = vault.backlinks[note.lang].get(note.key) ?? []
const alternates = Object.fromEntries(site.langs.map((l) => [l, vault.byKey[l].get(note.key)?.url]))
// An untranslated page shows the text of its fallback language, the original by
// default: hreflang lists only real versions, and the canonical URL is that page's.
const original = note.translated
  ? undefined
  : (vault.byKey[note.contentLang]?.get(note.key) ?? vault.byKey[note.sourceLang]?.get(note.key))
const translatedIn = site.langs.filter((l) => vault.byKey[l].get(note.key)?.translated)
const s = t(note.lang)
const related = await relatedNotes(note)
const mentions = await unlinkedMentions(note)
// A protected page ships only its ciphertext; the browser decrypts it with the password.
const password = vault.sources.get(note.key)?.password
const payload =
  note.protected && password
    ? await encrypt((await renderSecret(note)).html, password, site.encryption.iterations)
    : undefined
const image = note.banner ?? ogPath(note.slug)
// Pagefind filters match the folder and type selects of the search dialog; commas would split a value.
const pagefindFilters = [`folder:${note.dir.split("/")[0]}`, ...note.types.map((ty) => `type:${ty}`)]
  .map((f) => f.replace(/,/g, " "))
  .join(", ")
const jsonLd = noteLd(note, { title, description: r.description, image, words: r.words })
// A résumé and a gallery reshape the note's text; a page with a layout is a destination, not a note among others.
const html = layoutHtml(note, r.html)
const plain = !note.layout
// A book, a film or a project of a collection shows its cover beside its title.
const item = itemOf(note)
// A now page says when it was last true, and warns once it is three months old.
const nowSince = note.layout === "now" ? (note.updated ?? note.created) : undefined
const NOW_STALE_YEARS = 0.25
---

<Base noindex={note.draft || note.unlisted} mdAlternate={hasMarkdown(note) ? mdUrl(note) : undefined} oembed={embeddable(note) ? oembedUrl(note) : undefined} lang={note.lang} title={note.title} description={r.description} image={image} alternates={alternates} look={lookOf(note)} jsonLd={jsonLd} translatedIn={translatedIn} canonicalUrl={original?.url} rail>
  <div class="stack-row" data-stack-row>
  <div class="stack-col" data-stack-col data-url={note.url} data-title={title}>
  <article
    data-pagefind-body={site.search.engine === "pagefind" && !note.protected ? "" : undefined}
    data-pagefind-filter={site.search.engine === "pagefind" ? pagefindFilters : undefined}
    class:list={["note", { "is-blog": note.isBlog }, note.layout && `layout-${note.layout}`, ...note.cssclasses]}
    data-key={note.key}
    transition:name="note"
  >
    {
      note.banner && (
        <figure class="banner">
          <img src={note.banner} alt="" style={`object-position: ${note.bannerPos}`} />
        </figure>
      )
    }
    <Breadcrumbs lang={note.lang} dir={note.dir} />
    {
      plain && r.words >= 300 && (
        <div class="reading-progress" data-progress data-words={r.words} data-left={s.minutesLeft} aria-hidden="true">
          <span class="reading-progress-fill" />
          <span class="reading-progress-left" hidden />
        </div>
      )
    }
    {note.draft && <p class="draft-banner" role="note">✏️ {s.draftBanner}</p>}
    <DevProblems file={note.source.key + ".md"} />
    {
      note.layout === "cv" && !note.protected ? (
        <CvHead note={note} title={title} />
      ) : note.layout === "links" ? (
        <LinksHead note={note} title={title} />
      ) : item ? (
        <ItemHead note={note} item={item}>
          <header class="note-head">
            <NoteMeta note={note} words={r.words}>
              <h1 class="note-title">{title}</h1>
            </NoteMeta>
            <PageMenu note={note} />
          </header>
        </ItemHead>
      ) : (
        <header class="note-head">
          <NoteMeta note={note} words={r.words}>
            <h1 class="note-title">{title}</h1>
          </NoteMeta>
          <PageMenu note={note} />
        </header>
      )
    }
    {
      nowSince && (
        <div class="now-stamp">
          <p>
            <time datetime={nowSince.toISOString()}>{s.nowUpdated.replace("{date}", formatDate(nowSince, note.lang))}</time>
          </p>
          <p class="outdated" role="note" data-outdated data-since={nowSince.toISOString()} data-after={NOW_STALE_YEARS} hidden={!isOutdated(nowSince, NOW_STALE_YEARS)}>
            ⏳ {s.nowStale}
          </p>
        </div>
      )
    }
    <Outdated note={note} />
    <TrailBar note={note} at="head" />
    <SeriesBox note={note} at="head" />
    {
      note.deck && !note.protected && (
        <div
          class="practice-bar"
          data-practice
          data-start={s.practiceStart}
          data-show={s.practiceShow}
          data-again={s.practiceAgain}
          data-good={s.practiceGood}
          data-done={s.practiceDone}
          data-close={s.close}
          hidden
        />
      )
    }
    {
      payload ? (
        <>
          <form class="locked" data-payload={payload} data-iterations={site.encryption.iterations}>
            <p>🔒 {s.locked}</p>
            <label>
              <span class="sr-only">{s.password}</span>
              <input type="password" name="password" placeholder={s.password} autocomplete="current-password" required />
            </label>
            <button type="submit">{s.unlock}</button>
            <p class="locked-error" hidden>
              {s.wrongPassword}
            </p>
          </form>
          <div class="prose" hidden />
        </>
      ) : (
        <>
          {original && (
            <p class="untranslated">
              🌐 {s.untranslated.replace("{lang}", langMeta(note.lang).name)}{" "}
              <a href={original.url} hreflang={langMeta(original.lang).html}>
                {s.readOriginal} ({langMeta(original.lang).name})
              </a>
            </p>
          )}
          <div class="prose" lang={original ? langMeta(original.lang).html : undefined} set:html={html} />
          {isCollection(note.layout) && <Collection note={note} kind={note.layout} />}
        </>
      )
    }
    <TrailBar note={note} at="foot" />
    <SeriesBox note={note} at="foot" />
    <DayNav note={note} />
    {
      !note.isHome && hasHistory(note) && (
        <p class="history-link">
          <a href={historyUrl(note)}>{s.historyLink.replace("{n}", String(noteVersions(note).length))}</a>
        </p>
      )
    }
  </article>
  {plain && <section class="backlinks">
    <h2>{s.backlinks} <span class="count">{backlinks.length}</span></h2>
    {
      backlinks.length ? (
        <div class="backlink-grid">
          {backlinks.map((b) => (
            <a class="backlink internal" href={b.note.url}>
              <strong>{b.note.title}</strong>
              {b.context && <p>{b.context}</p>}
            </a>
          ))}
        </div>
      ) : (
        <p class="empty">{s.noBacklinks}</p>
      )
    }
  </section>}
  {
    plain && related.length > 0 && (
      <section class="backlinks related">
        <h2>{s.related}</h2>
        <div class="backlink-grid">
          {related.map((r) => (
            <a class="backlink internal" href={r.note.url}>
              <strong>{r.note.title}</strong>
              <p>{[...r.tags.map((x) => "#" + x), r.links ? s.sharedLinks(r.links) : "", r.similarity ? s.similarIdea : ""].filter(Boolean).join(" · ")}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }
  {
    plain && mentions.length > 0 && (
      <details class="backlinks mentions">
        <summary>
          <h2>
            {s.unlinkedMentions} <span class="count">{mentions.length}</span>
          </h2>
        </summary>
        <div class="backlink-grid">
          {mentions.map((m) => (
            <a class="backlink internal" href={m.note.url}>
              <strong>{m.note.title}</strong>
              <p>{m.context}</p>
            </a>
          ))}
        </div>
      </details>
    )
  }
  </div>
  </div>
  <Subscribe lang={note.lang} />
  <Webmentions lang={note.lang} url={note.url} />
  <Comments lang={note.lang} />
  <Fragment slot="rail">
    <Toc headings={r.headings} lang={note.lang} />
    <LocalGraph lang={note.lang} current={note.url} />
  </Fragment>
</Base>
