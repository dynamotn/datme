---
import { site, type Lang } from "~/site.config"
import type { Doc } from "~/lib/vault"
import { baseViews, renderBaseView } from "~/lib/base-render"
import { expandEmbeds } from "~/lib/markdown"
import { docUrl } from "~/lib/obsidian"
import Base from "~/layouts/Base.astro"
import Breadcrumbs from "../Breadcrumbs.astro"

interface Props {
  lang: Lang
  doc: Doc
}
const { lang, doc } = Astro.props
const views = baseViews(doc)
const alternates = Object.fromEntries(site.langs.map((l) => [l, docUrl(doc.rel, l)]))
// A feed view embeds its notes, filled in here as a note's renderer would.
const sections = await Promise.all((views.length ? views : [undefined]).map(async (name) => ({ name, html: await expandEmbeds(renderBaseView(doc, name, lang, undefined, false), lang) })))
---

<Base lang={lang} title={doc.name} alternates={alternates}>
  <div class="note is-wide base-page">
    <Breadcrumbs lang={lang} dir={doc.dir} />
    <header class="page-head">
      <span class="chip type">🗃️ Base</span>
      <h1>{doc.name}</h1>
    </header>
    {
      sections.map(({ name, html }) => (
        <section class="base-section">
          {views.length > 1 && <h2>{name}</h2>}
          <div class="prose" set:html={html} />
        </section>
      ))
    }
  </div>
</Base>
