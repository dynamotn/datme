---
import type { Lang } from "~/site.config"
import { site } from "~/site.config"
import { getVault, byRecent, countNotes, type FolderNode } from "~/lib/vault"
import { renderNote } from "~/lib/markdown"
import { t } from "~/lib/i18n"
import { feedPath } from "~/lib/feed"
import Subscribe from "../Subscribe.astro"
import Base from "~/layouts/Base.astro"
import Breadcrumbs from "../Breadcrumbs.astro"
import NoteRow from "../NoteRow.astro"
import Icon from "../Icon.astro"
import IndexCard from "../IndexCard.astro"

interface Props {
  lang: Lang
  folder: FolderNode
}
const { lang, folder } = Astro.props
const s = t(lang)
const vault = getVault()
const intro = folder.folderNote ? await renderNote(folder.folderNote) : undefined
const stage = site.stages[folder.segment]
const alternates = Object.fromEntries(site.langs.map((l) => [l, vault.folders[l].get(folder.dir)?.url]))
const feed = "/" + feedPath(lang, { kind: "folder", dir: folder.dir })
const parent = folder.dir.includes("/") ? folder.dir.slice(0, folder.dir.lastIndexOf("/")) : ""
---

<Base lang={lang} title={folder.name} description={intro?.description} alternates={alternates} feed={feed}>
  <div class="note is-wide">
    <Breadcrumbs lang={lang} dir={parent} />
    <header class="page-head">
      <span class="chip stage">{stage ? `${stage.icon} ${stage.label[lang]}` : s.folder}</span>
      <h1>{folder.name}</h1>
      <p>{s.notesCount(countNotes(folder))} · <a href={feed}>{s.rss}</a></p>
    </header>
    {intro && <div class="prose" style="margin-bottom: 36px" set:html={intro.html} />}
    {
      folder.folders.length > 0 && (
        <div class="folder-grid">
          {folder.folders.map((f) => (
            <a class="folder-card" href={f.url}>
              <Icon name="folder" />
              {f.name}
              <span>{countNotes(f)}</span>
            </a>
          ))}
        </div>
      )
    }
    {
      folder.notes.length > 0 &&
        (site.appearance.style === "notebook" ? (
          <div class="card-wall">
            {byRecent(folder.notes).map((n) => (
              <IndexCard note={n} />
            ))}
          </div>
        ) : (
          <ul class="note-list">
            {byRecent(folder.notes).map((n) => (
              <NoteRow note={n} />
            ))}
          </ul>
        ))
    }
    <Subscribe lang={lang} topic={{ kind: "folder", value: folder.dir, label: folder.name }} />
  </div>
</Base>
