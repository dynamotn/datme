---
import type { Lang } from "~/site.config"
import { site } from "~/site.config"
import { getVault, byRecent, countNotes, type FolderNode } from "~/lib/vault"
import { renderNote } from "~/lib/markdown"
import { t, formatDate } from "~/lib/i18n"
import { isStream } from "~/lib/nav"
import { explainDir, explainFrame, explainLook, isGarden } from "~/lib/look"
import { previewOf } from "~/lib/dev-look"
import { feedPath } from "~/lib/feed"
import { withBase } from "~/lib/base"
import Subscribe from "../Subscribe.astro"
import { folderIcon } from "~/lib/icons"
import Base from "~/layouts/Base.astro"
import Breadcrumbs from "../Breadcrumbs.astro"
import NoteRow from "../NoteRow.astro"
import Icon from "../Icon.astro"
import IndexCard from "../IndexCard.astro"
import GardenBed from "../garden/GardenBed.astro"
import Front from "../broadsheet/Front.astro"
import Collection from "../Collection.astro"
import { isCollection, layoutHtml } from "~/lib/note-layouts"

interface Props {
  lang: Lang
  folder: FolderNode
}
const { lang, folder } = Astro.props
const s = t(lang)
const vault = getVault()
const intro = folder.folderNote ? await renderNote(folder.folderNote) : undefined
// Any unprotected folder note gives its folder its look and frame: its own style/chrome or its layout's defaults.
const owner = folder.folderNote && !folder.folderNote.protected ? folder.folderNote : undefined
const explained = {
  look: owner ? explainLook(owner) : explainDir(folder.dir, site.appearance),
  frame: owner ? explainFrame(owner) : explainFrame(undefined),
  target: { kind: "folder", dir: folder.dir, file: owner && owner.source.key + ".md" } as const,
}
const preview = previewOf(Astro.url)
const look = preview.style ?? explained.look.value
const frame = preview.chrome ?? explained.frame.value
const stage = site.stages[folder.segment]
// A folder note with a layout lays out its folder too: a collection replaces the list of notes.
const layout = owner?.layout
const collection = isCollection(layout) ? layout : undefined
const alternates = Object.fromEntries(site.langs.map((l) => [l, vault.folders[l].get(folder.dir)?.url]))
const feed = withBase("/" + feedPath(lang, { kind: "folder", dir: folder.dir }))
const parent = folder.dir.includes("/") ? folder.dir.slice(0, folder.dir.lastIndexOf("/")) : ""
// A stream shows short notes in full, newest first; a protected one only by its title.
const stream = isStream(folder.dir)
  ? await Promise.all(
      byRecent(folder.notes, "created").map(async (note) => ({ note, html: note.protected ? undefined : (await renderNote(note)).html })),
    )
  : undefined
---

<Base lang={lang} look={look} explained={explained} title={folder.name} description={intro?.description} alternates={alternates} feed={feed} frame={frame}>
  <div class="note is-wide">
    {frame !== "minimal" && <Breadcrumbs lang={lang} dir={parent} />}
    <header class="page-head">
      <span class="chip stage">{stage ? `${stage.icon} ${stage.label[lang]}` : s.folder}</span>
      <h1>{folder.name}</h1>
      <p>{s.notesCount(countNotes(folder))} · <a href={feed}>{s.rss}</a></p>
    </header>
    {intro && <div class="prose" style="margin-bottom: 36px" set:html={layout ? layoutHtml(folder.folderNote!, intro.html) : intro.html} />}
    {collection && folder.folderNote && <Collection note={folder.folderNote} kind={collection} />}
    {
      folder.folders.length > 0 && (
        <div class="folder-grid">
          {folder.folders.map((f) => (
            <a class="folder-card" href={f.url}>
              {folderIcon(f.dir) ? <Fragment set:html={folderIcon(f.dir)} /> : <Icon name="folder" />}
              {f.name}
              <span>{countNotes(f)}</span>
            </a>
          ))}
        </div>
      )
    }
    {
      !collection && stream && stream.length > 0 && (
        <div class="stream">
          {stream.map(({ note, html }) => (
            <article class="stream-item" data-key={note.key}>
              <header>
                <a class="internal" href={note.url}>
                  {note.title}
                </a>
                {note.created && <time datetime={note.created.toISOString()}>{formatDate(note.created, lang)}</time>}
              </header>
              {html ? <div class="prose" set:html={html} /> : <p class="empty">🔒 {s.locked}</p>}
            </article>
          ))}
        </div>
      )
    }
    {
      !collection &&
        !stream &&
        folder.notes.length > 0 &&
        (isGarden(look) ? (
          <GardenBed notes={folder.notes} lang={lang} />
        ) : look === "broadsheet" ? (
          <Front lang={lang} notes={folder.notes} />
        ) : look === "notebook" ? (
          <div class="card-wall">
            {byRecent(folder.notes).map((n) => (
              <IndexCard note={n} level={2} />
            ))}
          </div>
        ) : (
          <ul class="note-list">
            {byRecent(folder.notes).map((n) => (
              <NoteRow note={n} />
            ))}
          </ul>
        ))
    }
    <Subscribe lang={lang} topic={{ kind: "folder", value: folder.dir, label: folder.name }} />
  </div>
</Base>
