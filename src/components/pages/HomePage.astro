---
import type { Lang } from "~/site.config"
import { site } from "~/site.config"
import { getVault, listed, byRecent, countNotes } from "~/lib/vault"
import { renderNote } from "~/lib/markdown"
import { t, langPrefix } from "~/lib/i18n"
import { slugToUrl } from "~/lib/slug"
import { absUrl, withBase } from "~/lib/base"
import { websiteLd } from "~/lib/jsonld"
import { previewOf } from "~/lib/dev-look"
import { baseStyle, isGarden } from "~/lib/look"
import Base from "~/layouts/Base.astro"
import NoteCard from "../NoteCard.astro"
import NoteRow from "../NoteRow.astro"
import Icon from "../Icon.astro"
import IndexCard from "../IndexCard.astro"
import GardenHome from "../garden/GardenHome.astro"
import Front from "../broadsheet/Front.astro"
import { editionDate } from "~/lib/broadsheet"

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const s = t(lang)
const vault = getVault()
const home = vault.home && vault.byKey[lang].get(vault.home.key)
const r = home ? await renderNote(home) : undefined

// The home note is split at each H2: the intro becomes the hero, the rest become shelves.
const [intro = "", ...shelves] = (r?.html ?? "").split(/(?=<h2[\s>])/)

const notes = listed(lang).filter((n) => !n.isHome)
const blog = byRecent(notes.filter((n) => n.isBlog), "created")
const recent = byRecent(notes).slice(0, 8)
const mocs = notes.filter((n) => n.isMoc)
const linkCount = notes.reduce((acc, n) => acc + n.links.length, 0)
// A stage links to its folder when one has its name; stages set by property have none.
const folderOf = new Map(vault.trees[lang].folders.map((f) => [f.segment, f]))
// Folder notes introduce their folder and are not counted, as in countNotes.
const counted = notes.filter((n) => n.source.stem !== n.dir.split("/").at(-1))
const stages = Object.entries(site.stages)
  .sort(([, a], [, b]) => a.order - b.order)
  .map(([key, stage]) => ({
    url: folderOf.get(key)?.url,
    icon: stage.icon,
    label: stage.label[lang],
    count: counted.filter((n) => n.stage === key).length,
  }))
  .filter((x) => x.count)
// Without configured stages, the home lists the top-level folders instead.
const shelvesOfFolders = stages.length
  ? stages
  : vault.trees[lang].folders.map((f) => ({ url: f.url, icon: "📁", label: f.name, count: countNotes(f) }))
const blogUrl = blog.length
  ? slugToUrl(langPrefix(lang) + "tags/" + (blog[0].tags.find((x) => site.conventions.blogTags.includes(x)) ?? ""))
  : ""
// A broadsheet is dated by its newest story.
const edition = byRecent(counted, "created")[0]?.created
// `datme dev` can preview the home in another style from its address.
const look = baseStyle(previewOf(Astro.url).style ?? site.appearance.style)
const alternates = Object.fromEntries(site.langs.map((l) => [l, slugToUrl(langPrefix(l) + "index")]))
---

<Base lang={lang} title={site.title[lang]} description={r?.description ?? site.tagline[lang]} image={home?.banner} alternates={alternates} jsonLd={websiteLd(lang)}>
  {/* The garden's author as a microformats card, for the fediverse bridges and IndieWeb readers. */}
  <div class="h-card" hidden>
    <a class="p-name u-url" href={absUrl(withBase("/"))}>{site.author || site.title[lang]}</a>
    {site.tagline[lang] && <p class="p-note">{site.tagline[lang]}</p>}
    {site.url && <img class="u-photo" src={absUrl(withBase("/icon-512.png"))} alt="" />}
  </div>
  <aside class="continue-reading" data-continue hidden>
    <a class="internal" href="#">
      <span class="continue-label">📖 {s.continueReading}</span>
      <strong data-continue-title></strong>
      <span class="continue-depth" data-continue-depth aria-hidden="true"></span>
    </a>
  </aside>
  {
    isGarden(look) ? (
      <GardenHome lang={lang} intro={intro} shelves={shelves} title={r?.h1 ?? site.title[lang]} />
    ) : look === "broadsheet" ? (
      <>
        <header class="bs-masthead">
          <p class="bs-dateline">
            {edition && <time datetime={edition.toISOString()}>{editionDate(edition, lang)}</time>}
            <span>{s.notesCount(counted.length)}</span>
          </p>
          <h1 class="bs-title">{r?.h1 ?? site.title[lang]}</h1>
          {site.tagline[lang] && <p class="bs-motto">{site.tagline[lang]}</p>}
        </header>
        {intro && <div class="prose bs-intro" set:html={intro} />}
        <Front lang={lang} notes={counted} bySection />
        {shelves.length > 0 && (
          <section class="section shelves">
            {shelves.map((html) => (
              <div class="shelf prose" set:html={html} />
            ))}
          </section>
        )}
      </>
    ) : look === "notebook" ? (
      <>
        <section class="nb-hero">
          <article class="nb-hero-main">
            {site.tagline[lang] && <span class="nb-kicker">{site.tagline[lang]}</span>}
            <h1>{r?.h1 ?? site.title[lang]}</h1>
            {intro && <div class="prose" set:html={intro} />}
            <div class="nb-metrics">
              <div><span>{s.notes}</span><strong>{notes.length}</strong></div>
              <div><span>{s.links}</span><strong>{linkCount}</strong></div>
              <div><span>{s.tags}</span><strong>{vault.tags[lang].size}</strong></div>
            </div>
          </article>
          {shelvesOfFolders.length > 0 && (
            <aside class="nb-hero-side">
              <h2>{stages.length ? s.stagesTitle : s.explorer}</h2>
              <ul>
                {shelvesOfFolders.map((f) => (
                  <li>
                    <a href={f.url}>
                      <span>{f.icon} {f.label}</span>
                      <b>{f.count}</b>
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          )}
        </section>

        {blog.length > 0 && (
          <section class="nb-section">
            <div class="nb-section-head">
              <h2>{s.blog}</h2>
              <a href={blogUrl}>{s.seeAll}</a>
            </div>
            <IndexCard note={blog[0]} date="created" featured />
            {blog.length > 1 && (
              <div class="card-wall">
                {blog.slice(1, 7).map((n) => (
                  <IndexCard note={n} date="created" media />
                ))}
              </div>
            )}
          </section>
        )}

        <section class="nb-section">
          <div class="nb-section-head">
            <h2>{s.recent}</h2>
            <span>{s.latest}</span>
          </div>
          <div class="card-wall">
            {recent.map((n) => (
              <IndexCard note={n} />
            ))}
          </div>
        </section>

        {mocs.length > 0 && (
          <section class="nb-section">
            <div class="nb-section-head">
              <h2>{s.maps}</h2>
            </div>
            <div class="card-wall">
              {mocs.map((n) => (
                <IndexCard note={n} />
              ))}
            </div>
          </section>
        )}

        {shelves.length > 0 && (
          <section class="nb-section card-wall">
            {shelves.map((html) => (
              <div class="nb-shelf prose" set:html={html} />
            ))}
          </section>
        )}
      </>
    ) : (
      <>
  <section class="hero">
    <span class="hero-eyebrow"><Icon name="sprout" /> {site.tagline[lang]}</span>
    <h1><span class="gradient-text">{r?.h1 ?? site.title[lang]}</span></h1>
    <div class="prose" set:html={intro} />
    <div class="hero-stats">
      <div class="stat"><b>{notes.length}</b><span>{s.notes}</span></div>
      <div class="stat"><b>{linkCount}</b><span>{s.links}</span></div>
      <div class="stat"><b>{vault.tags[lang].size}</b><span>{s.tags.toLowerCase()}</span></div>
    </div>
  </section>

  {
    blog.length > 0 && (
      <section class="section">
        <div class="section-head">
          <div>
            <h2>{s.blog}</h2>
            <p>{s.blogLead}</p>
          </div>
          <a href={blogUrl}>{s.seeAll} →</a>
        </div>
        <div class="card-grid">
          {blog.slice(0, 6).map((n) => <NoteCard note={n} />)}
        </div>
      </section>
    )
  }

  <div class="home-cols section">
    <section>
      <div class="section-head">
        <div>
          <h2>{s.recent}</h2>
          <p>{s.recentLead}</p>
        </div>
      </div>
      <ul class="note-list">
        {recent.map((n) => <NoteRow note={n} />)}
      </ul>
    </section>
    <section>
      <div class="section-head">
        <div>
          <h2>{stages.length ? s.garden : s.explorer}</h2>
          {stages.length > 0 && <p>{s.gardenLead}</p>}
        </div>
      </div>
      <div class="stage-grid">
        {
          shelvesOfFolders.map((f) => (
            <a class="stage-card" href={f.url}>
              <span class="emoji">{f.icon}</span>
              <span>
                <b>{f.label}</b>
                <span>{s.notesCount(f.count)}</span>
              </span>
            </a>
          ))
        }
      </div>
      {
        mocs.length > 0 && (
          <>
            <div class="section-head" style="margin-top: 32px">
              <div>
                <h2>{s.maps}</h2>
                <p>{s.mapsLead}</p>
              </div>
            </div>
            <ul class="note-list">
              {mocs.map((n) => (
                <NoteRow note={n} />
              ))}
            </ul>
          </>
        )
      }
    </section>
  </div>

  {
    shelves.length > 0 && (
      <section class="section shelves">
        {shelves.map((html) => (
          <div class="shelf prose" set:html={html} />
        ))}
      </section>
    )
  }
      </>
    )
  }
</Base>
