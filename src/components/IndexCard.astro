---
import type { Note } from "~/lib/vault"
import { site, type StyleName } from "~/site.config"
import { renderNote } from "~/lib/markdown"
import { formatDate, t, langMeta } from "~/lib/i18n"
import { typeInfo } from "~/lib/types"
import { drawSlot, noteFields } from "~/lib/pack-slots"
import { previewOf } from "~/lib/dev-look"
import Outdated from "./Outdated.astro"

interface Props {
  note: Note
  /** Which date to show; listings of new notes use created. */
  date?: "created" | "updated"
  /** Large card with the banner and a ribbon, for the newest blog post. */
  featured?: boolean
  /** Show the banner image when the note has one. */
  media?: boolean
  /** Level of the card title: one below the heading the cards sit under. */
  level?: 2 | 3
  /** Style of the page the card is on, whose theme pack template draws it if it has one. */
  look?: StyleName
}
const { note, date = "updated", featured = false, media = false, level = 3, look = previewOf(Astro.url).style ?? site.appearance.style } = Astro.props
const Heading = `h${level}` as const
const r = await renderNote(note)
const s = t(note.lang)
const stage = note.stage ? site.stages[note.stage] : undefined
const d = note[date]
const tags = note.tags.slice(0, 4)
const minutes = Math.max(1, Math.round(r.words / 220))
// The first type shapes the card: quotes, people and books each get their own look.
const kind = note.types[0]
const kindInfo = kind ? typeInfo(kind, note.lang) : undefined
const title = r.h1 ?? note.title
const initials = title
  .split(/\s+/)
  .filter((w) => /\p{L}/u.test(w))
  .slice(0, 2)
  .map((w) => w.match(/\p{L}/u)![0].toUpperCase())
  .join("")
// A theme pack's note-card is given what this card shows, and nothing of a protected note's text.
const packed = drawSlot("note-card", look, note.lang, noteFields(note, { title, date: d, excerpt: r.description, cover: (media || featured) && note.banner ? note.banner : undefined, words: r.words, tags, featured }))
---

{packed !== undefined ? <article class="pack-slot pack-note-card" data-slot="note-card" set:html={packed} /> :

<article class:list={["index-card", { featured }]} data-ribbon={featured ? s.featured : undefined} data-type={kind}>
  {
    (media || featured) && note.banner && (
      <a class="index-card-media" href={note.url} tabindex="-1" aria-hidden="true">
        <img src={note.banner} alt="" loading="lazy" style={`object-position: ${note.bannerPos}`} />
      </a>
    )
  }
  <p class="index-card-meta">
    {d && <time datetime={d.toISOString()}>{formatDate(d, note.lang)}</time>}
    <Outdated note={note} badge />
    {stage && <span>{stage.icon} {stage.label[note.lang]}</span>}
    {note.protected && <span title={s.locked}>🔒</span>}
    {!note.translated && <span class="lang-badge" title={langMeta(note.sourceLang).name}>{langMeta(note.sourceLang).short}</span>}
    {kindInfo && !featured && <span class="index-card-type">{kindInfo.icon} {kindInfo.label}</span>}
    {featured && <span>{s.readingTime(minutes)}</span>}
  </p>
  <Heading class="index-card-title">
    {kind === "person" && <span class="index-card-avatar" aria-hidden="true">{initials}</span>}
    <a class="internal" href={note.url}>{title}</a>
  </Heading>
  {r.description && <p class="index-card-excerpt">{r.description}</p>}
  {
    tags.length > 0 && (
      <ul class="index-card-tags">
        {tags.map((tag) => (
          <li>
            {tag.startsWith(site.conventions.typePrefix)
              ? typeInfo(tag.slice(site.conventions.typePrefix.length), note.lang).label
              : tag}
          </li>
        ))}
      </ul>
    )
  }
</article>}
