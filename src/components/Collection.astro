---
import type { Note } from "~/lib/vault"
import { site } from "~/site.config"
import { renderNote } from "~/lib/markdown"
import { formatDate, t } from "~/lib/i18n"
import { slugToUrl } from "~/lib/slug"
import { digestPath, episodesPath } from "~/lib/feed"
import {
  bookmarkOf,
  dailyDays,
  digestOf,
  firstParagraph,
  initials,
  listOf,
  peopleTies,
  priceTotals,
  quotebookOf,
  snippetOf,
  trackCharts,
  trackedOf,
  type DigestWeek,
} from "~/lib/collection-views"
import ActivityCalendar from "./ActivityCalendar.astro"
import {
  collectionOf,
  episodeNumber,
  field,
  formatPrice,
  linksOf,
  periodOf,
  placesOf,
  plain,
  priceOf,
  priorityOf,
  progressOf,
  questionOf,
  ratingOf,
  recipeFacts,
  specOf,
  whenOf,
  type Collection,
} from "~/lib/note-layouts"

interface Props {
  note: Note
  kind: Collection
}
const { note, kind } = Astro.props
const s = t(note.lang)
const scale = site.conventions.ratingScale
const spec = specOf(note, kind)
// A quotebook groups quotes and a digest weeks, not notes: both take the notes in their order.
const gathers = spec.look === "quotebook" || spec.look === "digest"
const all = collectionOf(note, gathers ? { ...spec, group: "none" } : spec)
// A journal lists its latest entries only (`limit`, 30 by default); its calendar and charts show every day.
const asked = Number(note.source.fm.limit)
let left = spec.look !== "daily" ? Infinity : asked > 0 ? asked : 30
const groups = all
  .map((g) => {
    const notes = g.notes.slice(0, left)
    left -= notes.length
    return { ...g, notes }
  })
  .filter((g) => g.notes.length)
const shown = groups.flatMap((g) => g.notes)
// Bookmarks quote their first paragraph and snippets show their code: their text is needed, not only a description.
const needsText = spec.look === "bookmarks" || spec.look === "snippets"
const rendered = new Map(
  await Promise.all(
    (gathers ? [] : shown).map(async (n) => [n.key, n.description && !needsText ? undefined : await renderNote(n)] as const),
  ),
)
const described = new Map(shown.map((n) => [n.key, n.description ?? rendered.get(n.key)?.description]))
const html = (n: Note) => rendered.get(n.key)?.html ?? ""
const fieldsOf = (n: Note) => spec.fields.map((f) => field(n, f)).filter(Boolean)
const days = spec.look === "daily" ? dailyDays(all.flatMap((g) => g.notes)) : undefined
const charts = days ? trackCharts(note, days) : []
const ties = spec.look === "people" ? peopleTies(shown) : []
const snippets = new Map(spec.look === "snippets" ? shown.map((n) => [n.key, snippetOf(n, html(n))]) : [])
const languages = [...new Set([...snippets.values()].map((x) => x.language).filter(Boolean))].sort()
const feed = spec.look === "episodes" && !note.protected ? slugToUrl(episodesPath(note)) : undefined
const map = kind === "places" ? placesOf(groups) : []
const quotes = spec.look === "quotebook" ? await quotebookOf(note, spec, shown) : []
const bySource = spec.group === "source"
const weeks = spec.look === "digest" ? digestOf(note, shown) : []
const digestFeed = spec.look === "digest" && !note.protected ? slugToUrl(digestPath(note)) : undefined
const empty = spec.look === "quotebook" ? quotes.length === 0 : spec.look === "digest" ? weeks.length === 0 : groups.length === 0
const day = (d: string) => formatDate(new Date(`${d}T00:00:00Z`), note.lang)
// What grew in a week: the notes planted, then those tended.
const partsOf = (w: DigestWeek) =>
  [
    { kind: "planted", icon: "🌱", label: s.planted, list: w.planted },
    { kind: "tended", icon: "🪴", label: s.tended, list: w.tended },
  ].filter((p) => p.list.length)
// The meta line of a card: the years of a project, the facts of a recipe, the place and date of a trip.
const metaOf = (n: Note) =>
  kind === "recipes"
    ? recipeFacts(n)
    : kind === "places"
      ? [...fieldsOf(n), whenOf(n) && n.source.fm.visited != null ? formatDate(whenOf(n), note.lang) : ""].filter(Boolean)
      : kind === "projects"
        ? [periodOf(n, note.lang), plain(n.source.fm.role)].filter(Boolean)
        : fieldsOf(n)
---

<div class:list={["collection", `collection-${kind}`]}>
  {
    map.length > 0 && (
      <div
        class="map-canvas collection-map"
        data-map={JSON.stringify(map)}
        data-tiles={site.map.tiles}
        data-tiles-dark={site.map.darkTiles}
        data-attribution={site.map.attribution}
        role="region"
        aria-label={s.map}
      />
    )
  }
  {days && <ActivityCalendar lang={note.lang} days={days} />}
  {
    charts.length > 0 && (
      <section class="daily-charts" aria-label={s.dailyOverTime}>
        <p class="panel-title">{s.dailyOverTime}</p>
        <div class="daily-chart-grid">
          {charts.map((c) => (
            <Fragment set:html={c} />
          ))}
        </div>
      </section>
    )
  }
  {
    feed && (
      <p class="collection-feed">
        <a href={feed} type="application/rss+xml">
          {s.episodesFeed}
        </a>
      </p>
    )
  }
  {
    languages.length > 1 && (
      <div class="snippet-filter" role="group" aria-label={s.snippetsFilter} data-snippet-filter>
        <button type="button" class="chip" data-snippet-lang="" aria-pressed="true">
          {s.snippetsAll}
        </button>
        {languages.map((l) => (
          <button type="button" class="chip" data-snippet-lang={l} aria-pressed="false">
            {l}
          </button>
        ))}
      </div>
    )
  }
  {
    digestFeed && (
      <p class="collection-feed">
        <a href={digestFeed} type="application/rss+xml">
          {s.digestFeed}
        </a>
      </p>
    )
  }
  {empty && <p class="empty">{s.emptyCollection}</p>}
  {
    quotes.map((g) => (
      <section class="collection-group" data-group={g.key || undefined}>
        {g.label && (
          <h2 class="collection-title">
            {g.note ? (
              <a class="internal" href={g.note.url}>
                {g.label}
              </a>
            ) : (
              g.label
            )}{" "}
            <span class="count">{g.quotes.length}</span>
          </h2>
        )}
        <div class="quote-wall quotebook-wall">
          {g.quotes.map((q) => {
            const meta = fieldsOf(q.note)
            return (
              <figure class="quote-card">
                <blockquote set:html={q.text} />
                <figcaption>
                  {(bySource || !g.label) && <span class="quote-who" set:html={q.who} />}
                  {!bySource && (
                    <a class="internal quote-source" href={q.note.url}>
                      {q.note.title}
                    </a>
                  )}
                  {meta.length > 0 && <span class="quote-meta">{meta.join(", ")}</span>}
                  <a class="quote-link" href={q.href}>
                    {s.quoteInContext}
                  </a>
                </figcaption>
              </figure>
            )
          })}
        </div>
      </section>
    ))
  }
  {
    weeks.map((w) => (
      <section class="collection-group digest-week" id={w.id.toLowerCase()}>
        <h2 class="collection-title">
          {w.label} <span class="count">{w.planted.length + w.tended.length}</span>
        </h2>
        <p class="digest-range">
          <time datetime={w.start}>{day(w.start)}</time> – <time datetime={w.end}>{day(w.end)}</time>
        </p>
        <div class="digest-parts">
          {partsOf(w).map((part) => (
              <div class:list={["digest-part", `is-${part.kind}`]}>
                <h3 class="digest-kind">
                  <span aria-hidden="true">{part.icon}</span> {part.label} <span class="count">{part.list.length}</span>
                </h3>
                <ul class="digest-list">
                  {part.list.map((e) => {
                    const meta = fieldsOf(e.note)
                    return (
                      <li>
                        <a class="internal" href={e.url}>
                          {e.note.title}
                        </a>
                        <time datetime={e.date.toISOString()}>{formatDate(e.date, note.lang)}</time>
                        {meta.length > 0 && <span class="digest-meta">{meta.join(" · ")}</span>}
                      </li>
                    )
                  })}
                </ul>
              </div>
          ))}
        </div>
      </section>
    ))
  }
  {
    !gathers && groups.map((g) => (
      <section class="collection-group" data-group={g.key || undefined}>
        {g.label && (
          <h2 class="collection-title">
            {g.label} <span class="count">{g.notes.length}</span>
          </h2>
        )}
        {spec.look === "wishlist" && priceTotals(g.notes, note.lang).length > 0 && (
          <p class="wish-total">{s.wishlistTotal.replace("{amount}", priceTotals(g.notes, note.lang).join(" + "))}</p>
        )}
        {spec.look === "courses" ? (
          <ol class="course-list">
            {g.notes.map((n) => {
              const progress = progressOf(n)
              const meta = [...fieldsOf(n), periodOf(n, note.lang)].filter(Boolean)
              return (
                <li class="course">
                  <div class="course-body">
                    <a class="talk-title internal" href={n.url}>
                      {n.title}
                    </a>
                    {meta.length > 0 && (
                      <p class="course-meta">
                        {meta.map((m) => (
                          <span>{m}</span>
                        ))}
                      </p>
                    )}
                    {described.get(n.key) && <p class="course-desc">{described.get(n.key)}</p>}
                    {n.certificate && (
                      <a class="course-cert" href={n.certificate.href} rel="noopener">
                        {s.certificate} ↗
                      </a>
                    )}
                  </div>
                  {progress && (
                    <div class="course-progress">
                      <progress max="100" value={progress.percent} aria-label={`${s.courseProgress}: ${n.title}`} />
                      <span>{progress.label}</span>
                    </div>
                  )}
                </li>
              )
            })}
          </ol>
        ) : spec.look === "wishlist" ? (
          <ul class="wish-grid">
            {g.notes.map((n) => {
              const price = priceOf(n)
              const priority = priorityOf(n)
              const meta = fieldsOf(n)
              const links = linksOf(n)
              return (
                <li class="card wish">
                  {n.cover && (
                    <a class="card-media internal" href={n.url} tabindex="-1" aria-hidden="true">
                      <img src={n.cover} alt="" loading="lazy" />
                    </a>
                  )}
                  <div class="card-body">
                    <h3 class="card-title">
                      <a class="internal" href={n.url}>{n.title}</a>
                    </h3>
                    {(price || priority.label) && (
                      <p class="wish-facts">
                        {price && <span class="wish-price">{formatPrice(price.amount, price.currency, note.lang)}</span>}
                        {priority.label && (
                          <span class="chip wish-priority">
                            {s.wishPriority}: {priority.label}
                          </span>
                        )}
                      </p>
                    )}
                    {meta.length > 0 && <p class="project-meta">{meta.join(" · ")}</p>}
                    {described.get(n.key) && <p class="card-desc">{described.get(n.key)}</p>}
                    {links.length > 0 && (
                      <p class="project-links">
                        {links.map((l) => (
                          <a href={l.href} rel="noopener">
                            {l.label} ↗
                          </a>
                        ))}
                      </p>
                    )}
                  </div>
                </li>
              )
            })}
          </ul>
        ) : spec.look === "questions" ? (
          <ol class="question-list">
            {g.notes.map((n) => {
              const q = questionOf(n)
              const meta = fieldsOf(n)
              return (
                <li class:list={["question", q.answered ? "is-answered" : "is-open"]}>
                  <span class="question-mark" aria-hidden="true">
                    {q.answered ? "✓" : "?"}
                  </span>
                  <div class="question-body">
                    <a class="talk-title internal" href={n.url}>
                      {n.title}
                    </a>
                    {(n.created || meta.length > 0) && (
                      <p class="question-meta">
                        {n.created && <time datetime={n.created.toISOString()}>{formatDate(n.created, note.lang)}</time>}
                        {meta.map((m) => (
                          <span>{m}</span>
                        ))}
                      </p>
                    )}
                    {described.get(n.key) && <p class="question-desc">{described.get(n.key)}</p>}
                    {q.answer && (
                      <p class="question-answer">
                        {s.questionAnswer}:{" "}
                        {q.answer.href ? (
                          <a
                            class:list={{ internal: !/^https?:/.test(q.answer.href) }}
                            href={q.answer.href}
                            rel={/^https?:/.test(q.answer.href) ? "noopener" : undefined}
                          >
                            {q.answer.text}
                          </a>
                        ) : (
                          q.answer.text
                        )}
                      </p>
                    )}
                  </div>
                </li>
              )
            })}
          </ol>
        ) : spec.look === "cards" ? (
          <div class="card-grid project-grid">
            {g.notes.map((n) => {
              const meta = metaOf(n)
              const stack = listOf(n.source.fm.stack ?? n.source.fm.tech)
              const links = linksOf(n)
              return (
                <article class="card project-card">
                  {n.cover && (
                    <a class="card-media internal" href={n.url} tabindex="-1" aria-hidden="true">
                      <img src={n.cover} alt="" loading="lazy" />
                    </a>
                  )}
                  <div class="card-body">
                    <h3 class="card-title">
                      <a class="internal" href={n.url}>{n.title}</a>
                    </h3>
                    {meta.length > 0 && <p class="project-meta">{meta.join(" · ")}</p>}
                    {described.get(n.key) && <p class="card-desc">{described.get(n.key)}</p>}
                    {stack.length > 0 && (
                      <ul class="project-stack">
                        {stack.map((x) => (
                          <li>{x}</li>
                        ))}
                      </ul>
                    )}
                    {links.length > 0 && (
                      <p class="project-links">
                        {links.map((l) => (
                          <a href={l.href} rel="noopener">
                            {l.label} ↗
                          </a>
                        ))}
                      </p>
                    )}
                  </div>
                </article>
              )
            })}
          </div>
        ) : spec.look === "daily" ? (
          <ol class="talk-list daily-list">
            {g.notes.map((n) => {
              const when = whenOf(n)
              const meta = [...fieldsOf(n), ...trackedOf(note, n)]
              return (
                <li class="talk">
                  {when && (
                    <time class="talk-date" datetime={when.toISOString()}>
                      {formatDate(when, note.lang)}
                    </time>
                  )}
                  <div class="talk-body">
                    <a class="talk-title internal" href={n.url}>
                      {n.title}
                    </a>
                    {meta.length > 0 && <span class="talk-meta">{meta.join(" · ")}</span>}
                    {described.get(n.key) && <span class="daily-desc">{described.get(n.key)}</span>}
                  </div>
                </li>
              )
            })}
          </ol>
        ) : spec.look === "bookmarks" ? (
          <ol class="bookmark-list">
            {g.notes.map((n) => {
              const b = bookmarkOf(n)
              const comment = firstParagraph(html(n))
              return (
                <li class="bookmark">
                  <span class="bookmark-icon" aria-hidden="true">
                    {b.icon ? (
                      <svg viewBox="0 0 24 24" width="18" height="18">
                        <path d={b.icon} fill="currentColor" />
                      </svg>
                    ) : (
                      b.letter
                    )}
                  </span>
                  <div class="bookmark-body">
                    <a class="bookmark-title internal" href={n.url}>
                      {n.title}
                    </a>
                    <p class="bookmark-meta">
                      {b.href && (
                        <a class="bookmark-site" href={b.href} rel="noopener">
                          {b.site} ↗
                        </a>
                      )}
                      {fieldsOf(n).map((f) => (
                        <span>{f}</span>
                      ))}
                      {b.published && <time datetime={b.published.toISOString()}>{formatDate(b.published, note.lang)}</time>}
                    </p>
                    {comment && <p class="bookmark-comment" set:html={comment} />}
                  </div>
                </li>
              )
            })}
          </ol>
        ) : spec.look === "people" ? (
          <ul class="people-grid">
            {g.notes.map((n) => {
              const links = linksOf(n)
              return (
                <li class="person">
                  <a class="person-link internal" href={n.url}>
                    {n.cover ? (
                      <img class="person-avatar" src={n.cover} alt="" loading="lazy" />
                    ) : (
                      <span class="person-avatar person-initials" aria-hidden="true">
                        {initials(n.title)}
                      </span>
                    )}
                    <span class="person-name">{n.title}</span>
                  </a>
                  {fieldsOf(n).map((f) => (
                    <span class="person-meta">{f}</span>
                  ))}
                  {links.length > 0 && (
                    <span class="project-links person-links">
                      {links.map((l) => (
                        <a href={l.href} rel="noopener">
                          {l.label} ↗
                        </a>
                      ))}
                    </span>
                  )}
                </li>
              )
            })}
          </ul>
        ) : spec.look === "snippets" ? (
          <div class="snippet-grid">
            {g.notes.map((n) => {
              const snippet = snippets.get(n.key)!
              return (
                <article class="card snippet" data-language={snippet.language}>
                  <div class="snippet-head">
                    <h3 class="card-title">
                      <a class="internal" href={n.url}>{n.title}</a>
                    </h3>
                    {snippet.language && <span class="chip snippet-lang">{snippet.language}</span>}
                  </div>
                  {described.get(n.key) && <p class="card-desc">{described.get(n.key)}</p>}
                  {snippet.code && <div class="snippet-code" set:html={snippet.code} />}
                </article>
              )
            })}
          </div>
        ) : spec.look === "episodes" ? (
          <ol class="episode-list">
            {g.notes.map((n) => {
              const when = whenOf(n)
              const number = episodeNumber(n)
              const duration = field(n, "duration|length")
              const guests = fieldsOf(n)
              return (
                <li class="episode">
                  <span class="episode-number">{number ? `#${field(n, "number|episode|ep")}` : ""}</span>
                  <div class="episode-body">
                    <a class="talk-title internal" href={n.url}>
                      {n.title}
                    </a>
                    <p class="episode-meta">
                      {when && <time datetime={when.toISOString()}>{formatDate(when, note.lang)}</time>}
                      {duration && <span>{duration}</span>}
                      {guests.length > 0 && <span>{s.episodeWith} {guests.join(", ")}</span>}
                    </p>
                    {described.get(n.key) && <p class="episode-desc">{described.get(n.key)}</p>}
                    {n.audio && <audio src={n.audio.href} controls preload="none" aria-label={n.title} />}
                  </div>
                </li>
              )
            })}
          </ol>
        ) : spec.look === "rows" ? (
          <ol class="talk-list">
            {g.notes.map((n) => {
              const when = whenOf(n)
              const meta = fieldsOf(n)
              const links = linksOf(n)
              return (
                <li class="talk">
                  {when && (
                    <time class="talk-date" datetime={when.toISOString()}>
                      {formatDate(when, note.lang)}
                    </time>
                  )}
                  <div class="talk-body">
                    <a class="talk-title internal" href={n.url}>
                      {n.title}
                    </a>
                    {meta.length > 0 && <span class="talk-meta">{meta.join(" · ")}</span>}
                    {links.length > 0 && (
                      <span class="project-links">
                        {links.map((l) => (
                          <a href={l.href} rel="noopener">
                            {l.label} ↗
                          </a>
                        ))}
                      </span>
                    )}
                  </div>
                </li>
              )
            })}
          </ol>
        ) : (
          <ul class="book-shelf">
            {g.notes.map((n) => {
              const meta = fieldsOf(n)
              const rating = ratingOf(n)
              return (
                <li class="book">
                  <a class="book-link internal" href={n.url}>
                    <span class="book-cover">
                      {n.cover ? <img src={n.cover} alt="" loading="lazy" /> : <span class="book-cover-text">{n.title}</span>}
                    </span>
                    <span class="book-title">{n.title}</span>
                  </a>
                  {meta.length > 0 && <span class="book-author">{meta.join(", ")}</span>}
                  {rating && (
                    <span class="book-rating" title={`${s.ratingOf} ${rating}/${scale}`} aria-label={`${s.ratingOf} ${rating}/${scale}`}>
                      {"★".repeat(Math.round(rating))}
                      <span class="book-rating-rest">{"★".repeat(scale - Math.round(rating))}</span>
                    </span>
                  )}
                </li>
              )
            })}
          </ul>
        )}
      </section>
    ))
  }
  {
    ties.length > 0 && (
      <section class="collection-group people-graph" aria-labelledby="people-ties">
        <h2 class="collection-title" id="people-ties">
          {s.peopleLinks} <span class="count">{ties.length}</span>
        </h2>
        <div class="graph-box">
          <canvas
            data-graph="set"
            data-lang={note.lang}
            data-urls={JSON.stringify(shown.map((n) => n.url))}
            role="img"
            aria-label={s.peopleLinks}
          />
          <div class="graph-zoom" role="group" aria-label={s.zoom}>
            <button type="button" data-graph-zoom="1" aria-label={s.zoomIn} title={s.zoomIn}>+</button>
            <button type="button" data-graph-zoom="-1" aria-label={s.zoomOut} title={s.zoomOut}>−</button>
          </div>
        </div>
        <ul class="people-ties">
          {ties.map(([a, b]) => (
            <li>
              <a class="internal" href={a.url}>{a.title}</a> ↔ <a class="internal" href={b.url}>{b.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>
