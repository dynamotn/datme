---
import { site, type Lang } from "~/site.config"
import { t } from "~/lib/i18n"
import Icon from "./Icon.astro"

interface Props {
  lang: Lang
  current?: string
  /** Whether it shows its own title; off where a heading already names it. */
  heading?: boolean
}
const { lang, current, heading = true } = Astro.props
const s = t(lang)
---

<section>
  {heading && <p class="panel-title">{s.graph}</p>}
  <div class="graph-box">
    <canvas data-graph="local" data-lang={lang} data-current={current} data-depth={site.graph.depth}></canvas>
    <div class="graph-depth" role="group" aria-label={s.graphDepth} title={s.graphDepth}>
      <button type="button" data-graph-depth="1" aria-pressed="false" aria-label={s.graphDepth1} title={s.graphDepth1}>1</button>
      <button type="button" data-graph-depth="2" aria-pressed="false" aria-label={s.graphDepth2} title={s.graphDepth2}>2</button>
    </div>
    <button class="icon-btn graph-expand" type="button" data-open-graph aria-label={s.globalGraph}>
      <Icon name="expand" />
    </button>
    <div class="graph-zoom" role="group" aria-label={s.zoom}>
      <button type="button" data-graph-zoom="1" aria-label={s.zoomIn} title={s.zoomIn}>+</button>
      <button type="button" data-graph-zoom="-1" aria-label={s.zoomOut} title={s.zoomOut}>−</button>
    </div>
  </div>
</section>
