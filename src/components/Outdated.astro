---
import type { Note } from "~/lib/vault"
import { t, formatDate } from "~/lib/i18n"
import { wilting } from "~/lib/outdated"

interface Props {
  note: Note
  /** A ⏳ next to a card's date instead of the sentence under a note's title. */
  badge?: boolean
}
const { note, badge = false } = Astro.props
const w = wilting(note)
const text = w && t(note.lang).outdated.replace("{date}", formatDate(w.since, note.lang))
---

{
  w &&
    (badge ? (
      <span class="wilt" title={text} data-outdated data-since={w.since.toISOString()} data-after={w.after} hidden={!w.now}>
        ⏳<span class="sr-only">{text}</span>
      </span>
    ) : (
      <p class="outdated" role="note" data-outdated data-since={w.since.toISOString()} data-after={w.after} hidden={!w.now}>
        ⏳ {text}
      </p>
    ))
}
