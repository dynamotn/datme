---
import Base from "~/layouts/Base.astro"
import { site } from "~/site.config"
import { t } from "~/lib/i18n"
import { withBase } from "~/lib/base"

const lang = site.defaultLang
const s = t(lang)
const others = site.langs.slice(1)
---

<Base lang={lang} title={s.notFound} alternates={{}}>
  <div class="note" style="text-align: center; padding: 10vh 0">
    <p style="font-size: 64px; margin: 0">🌾</p>
    <h1 class="note-title">{s.notFound}</h1>
    <p class="empty">{s.notFoundLead}</p>
    {others.map((l) => <p class="empty">{t(l).notFound} — {t(l).notFoundLead}</p>)}
    <p class="chips" style="justify-content: center">
      <button class="chip not-found-back" type="button" data-base={withBase("/")} hidden>← {s.backPrevious}</button>
      <a class="chip stage" href={withBase("/")}>{s.backHome}</a>
    </p>
  </div>
  <script is:inline>
    ;(() => {
      // Only when the reader came here from a page of this garden: a link typed or pasted
      // from outside has nothing to go back to.
      const back = document.querySelector(".not-found-back")
      if (!back || history.length < 2) return
      let from = null
      try {
        from = new URL(document.referrer)
      } catch {}
      if (!from || from.origin !== location.origin || from.href === location.href) return
      // Another garden served from the same host is not this one.
      if (!from.pathname.startsWith(back.dataset.base || "/")) return
      back.hidden = false
      back.addEventListener("click", () => history.back())
    })()
  </script>
</Base>
