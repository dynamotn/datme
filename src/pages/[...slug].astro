---
import type { GetStaticPaths } from "astro"
import { routes, type Page } from "~/lib/routes"
import NotePage from "~/components/pages/NotePage.astro"
import HomePage from "~/components/pages/HomePage.astro"
import FolderPage from "~/components/pages/FolderPage.astro"
import TagPage from "~/components/pages/TagPage.astro"
import AliasRedirect from "~/components/pages/AliasRedirect.astro"
import CanvasPage from "~/components/pages/CanvasPage.astro"
import BasePage from "~/components/pages/BasePage.astro"
import ArchivePage from "~/components/pages/ArchivePage.astro"


export const getStaticPaths = (() =>
  [...routes()].map(([slug, page]) => ({ params: { slug: slug || undefined }, props: { page } }))) satisfies GetStaticPaths

const { page } = Astro.props as { page: Page }
---

{page.kind === "home" && <HomePage lang={page.lang} />}
{page.kind === "note" && <NotePage note={page.note} />}
{page.kind === "folder" && <FolderPage lang={page.lang} folder={page.folder} />}
{page.kind === "tag" && <TagPage lang={page.lang} tag={page.tag} />}
{page.kind === "alias" && <AliasRedirect note={page.note} />}
{page.kind === "canvas" && <CanvasPage lang={page.lang} doc={page.doc} />}
{page.kind === "base" && <BasePage lang={page.lang} doc={page.doc} />}
{page.kind === "archive" && <ArchivePage lang={page.lang} />}
